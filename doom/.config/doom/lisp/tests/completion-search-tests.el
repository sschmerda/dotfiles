;;; completion-search-tests.el --- Ranked symbol matching -*- lexical-binding: t; -*-

;; Reuse installed package paths and the real symbol fixtures/regression suite.
(load (expand-file-name "project-symbols-tests.el" (file-name-directory load-file-name)) nil t)
(require 'orderless)
(require 'vertico)

(defun my--test-completion-search-table (candidates)
  "Return a completion table preserving original candidate identity."
  (lambda (input predicate action)
    (if (eq action 'metadata) '(metadata (category . consult-lsp-symbols))
      (complete-with-action action candidates input predicate))))

(defun my--test-completion-search-results (query table &optional predicate)
  "Run actual completion matching and remove its optional base-size tail."
  (let ((matches (completion-all-completions query table predicate (length query))))
    (when matches (setcdr (last matches) nil))
    matches))

(ert-deftest my-completion-search-native-filters-and-ranks-original-candidates ()
  (with-temp-buffer
    (let* ((my-completion-search-default 'normal)
           (my-completion-fuzzy-backend 'fzf-native)
           (candidates (mapcar (lambda (name) (propertize name 'consult--candidate (list :name name)))
                               '("x_c_a_l_c_b_o_n_x" "calculate_bonus" "unrelated")))
           (table (my--test-completion-search-table candidates)))
      (my--completion-search-setup 'project-symbols #'ignore)
      (my--completion-search-set-mode 'fuzzy)
      (let* ((matches (my--test-completion-search-results "calbon" table))
             (sorted (cl-letf (((symbol-function 'minibuffer-contents-no-properties) (lambda () "calbon")))
                              (my--symbols-sort nil matches))))
        (should (= (length matches) 2))
        (should (equal (car sorted) "calculate_bonus"))
        (should (numberp (get-text-property 0 'completion-score (car sorted))))
        (should (eq (get-text-property 0 'consult--candidate (car sorted))
                    (get-text-property 0 'consult--candidate (nth 1 candidates)))))
      ;; These candidates never passed an Orderless prefilter.
      (should-not (my--test-completion-search-results "'calbon" table))
      (should (= 1 (length (my--test-completion-search-results "calbon !x" table))))
      (should-not (my--test-completion-search-results "nomatch" table))
      (should (equal (substring-no-properties (nth 1 candidates)) "calculate_bonus"))
      (should-not (text-property-not-all 0 (length (nth 1 candidates)) 'face nil (nth 1 candidates))))))

(ert-deftest my-completion-search-restores-normal-and-never-enables-other-pickers ()
  (let ((styles (copy-tree completion-styles))
        (overrides (copy-tree completion-category-overrides))
        (defaults (copy-tree completion-category-defaults)))
    (with-temp-buffer
      (let ((my-completion-search-default 'normal))
        (setq-local completion-styles '(orderless basic)
                    completion-ignore-case nil)
        (my--completion-search-setup 'buffer-symbols #'ignore)
        (my--completion-search-set-mode 'fuzzy)
        (should (equal completion-styles '(fussy)))
        (my--completion-search-set-mode 'normal)
        (should (equal completion-styles '(orderless basic)))
        (should-not completion-ignore-case)
        (should (equal completion-category-overrides overrides))))
    (with-temp-buffer
      (should-not my--completion-search-session)
      (should-not (my--completion-search-fuzzy-p)))
    (should (equal styles completion-styles))
    (should (equal overrides completion-category-overrides))
    (should (equal defaults completion-category-defaults))))

(ert-deftest my-completion-search-defaults-and-backend-failure-are-local ()
  (let ((my-completion-search-default 'normal)
        (my-completion-search-defaults '((buffer-symbols . fuzzy))))
    (with-temp-buffer
      (my--completion-search-setup 'buffer-symbols #'ignore)
      (should (my--completion-search-fuzzy-p)))
    (with-temp-buffer
      (my--completion-search-setup 'project-symbols #'ignore)
      (should-not (my--completion-search-fuzzy-p))
      (let ((styles completion-styles))
        (cl-letf (((symbol-function 'my--completion-search-prepare-backend)
                   (lambda () (error "Missing native module"))))
                 (should-error (my--completion-search-set-mode 'fuzzy)))
        (should-not (my--completion-search-fuzzy-p))
        (should (equal completion-styles styles))))))

(ert-deftest my-completion-search-flx-backend-is-functional ()
  (with-temp-buffer
    (let ((my-completion-fuzzy-backend 'flx))
      (my--completion-search-setup 'buffer-symbols #'ignore)
      (my--completion-search-set-mode 'fuzzy)
      (let ((matches (my--test-completion-search-results
                      "clbn" (my--test-completion-search-table '("calculate_bonus" "unrelated")))))
        (should (= (length matches) 1))
        (should (text-property-any 0 (length (car matches)) 'face 'my-completion-fuzzy-match (car matches)))))))

(ert-deftest my-completion-search-fuzzy-default-recovers-from-load-error ()
  (with-temp-buffer
    (setq-local completion-styles '(orderless))
    (let ((my-completion-search-default 'fuzzy) warning)
      (cl-letf (((symbol-function 'my--completion-search-prepare-backend)
                 (lambda () (error "Missing native module")))
                ((symbol-function 'message)
                 (lambda (format-string &rest args)
                   (setq warning (apply #'format format-string args)))))
        (my--completion-search-setup 'buffer-symbols #'ignore)
        (should (string-search "Missing native module" warning))
        (should (eq my--completion-search-session 'buffer-symbols))
        (should (eq my--completion-search-mode 'normal))
        (should (equal completion-styles '(orderless)))))))

(ert-deftest my-completion-search-ranks-symbols-with-long-paths ()
  (dolist (backend '(flx fzf-native))
    (with-temp-buffer
      (let* ((my-completion-fuzzy-backend backend)
             (candidate (concat "needle — " (make-string 420 ?a) "/module.py:1"))
             (table (my--test-completion-search-table (list "other" candidate))))
        (my--completion-search-setup 'project-symbols #'ignore)
        (my--completion-search-set-mode 'fuzzy)
        (let ((matches (my--test-completion-search-results "needle" table)))
          (should (equal matches (list candidate)))
          (should (numberp (get-text-property 0 'completion-score (car matches)))))))))

(ert-deftest my-completion-search-same-line-symbols-retain-distinct-identities ()
  (let* ((workspace (make-lsp--workspace :root "/project"))
         (originals
          (mapcar (lambda (column)
                    (my--project-symbols-candidate
                     workspace (list :name "x" :kind 13
                                     :location (list :uri "file:///project/a.py"
                                                     :range (list :start (list :line 0 :character column))))))
                  '(0 8)))
         (candidates (my--symbols-disambiguate originals))
         (second (cadr candidates)))
    (should (equal (car originals) (cadr originals)))
    (should (equal (my--symbols-relative-location second "/project/") "a.py:1:9"))
    (should (equal (my--symbols-relative-location second "/project/" t) "a.py"))
    (should (= (cl-position second candidates :test #'equal) 1))
    (should (eq (consult--lookup-candidate (substring-no-properties second) candidates)
                (get-text-property 0 'consult--candidate (cadr originals))))))

(ert-deftest my-completion-search-fuzzy-highlight-preserves-unicode-metadata-and-selected-row ()
  (with-temp-buffer
    (my--completion-search-setup 'buffer-symbols #'ignore)
    (my--completion-search-set-mode 'fuzzy)
    (let* ((identity (list :id 1))
           (candidate (propertize "β_calculate_bonus" 'consult--candidate identity 'face 'font-lock-function-name-face))
           (vertico--index 0))
      (cl-letf (((symbol-function 'minibuffer-contents-no-properties) (lambda () "calbon")))
               (let* ((highlighted (my--completion-search-highlight candidate))
                      (rendered (vertico--format-candidate highlighted "" "" 0 0)))
                 (should (eq identity (get-text-property 0 'consult--candidate highlighted)))
                 (should (memq 'my-completion-fuzzy-match (ensure-list (get-text-property 2 'face rendered))))
                 (should (memq 'vertico-current (ensure-list (get-text-property 2 'face rendered))))
                 (should-not (memq 'my-completion-fuzzy-match (ensure-list (get-text-property 0 'face rendered)))))
               (should (eq (get-text-property 2 'face candidate) 'font-lock-function-name-face))))))

(ert-deftest my-completion-search-symbols-flat-query-restores-source-and-keeps-filters ()
  (with-temp-buffer
    (let* ((my-project-symbols-default-order 'source) (my-symbols-remember-order nil)
           (candidates (my--test-symbols-presentation-candidates))
           (interface (my--project-symbols-interface candidates 'project))
           (my--symbols-view (plist-get interface :view))
           (table (my--test-completion-search-table candidates))
           (input "method")
           (consult--narrow ?M)
           (predicate (plist-get (plist-get interface :narrow) :predicate)))
      (my--completion-search-setup 'project-symbols #'ignore)
      (my--completion-search-set-mode 'fuzzy)
      (cl-letf (((symbol-function 'minibuffer-contents-no-properties) (lambda () input)))
               (let* ((matches (my--test-completion-search-results input table predicate))
                      (group (plist-get interface :group))
                      (view my--symbols-view))
                 (should (= (length matches) 2))
                 (should (cl-every (lambda (c) (eq (get-text-property 0 'consult--type c) ?M)) matches))
                 (should-not (funcall group (car matches) nil))
                 (let ((affix (my--project-symbols-annotate-builder view)))
                   ;; A child remains flat while retaining its parent metadata.
                   (should-not (string-search "─" (cadr (funcall affix (car matches))))))
                 (setq input "")
                 (should (equal (funcall group (car matches) nil) "a.py"))
                 (should (eq (plist-get view :order) 'source)))))))

(ert-deftest my-completion-search-path-highlights-survive-relative-root-and-clipping ()
  (with-temp-buffer
    (my--completion-search-setup 'buffer-symbols #'ignore)
    (my--completion-search-set-mode 'fuzzy)
    (let* ((workspace (make-lsp--workspace :root "/"))
           (symbol (my--project-symbols-object
                    :name "function" :kind 12
                    :location (my--project-symbols-object
                               :uri "file:///project/long/directory/target.py"
                               :range (my--project-symbols-object
                                       :start (my--project-symbols-object :line 0 :character 0)))))
           (candidate (my--project-symbols-candidate workspace symbol)))
      (cl-letf (((symbol-function 'minibuffer-contents-no-properties) (lambda () "fn target")))
               (let* ((highlighted (my--completion-search-highlight candidate))
                      (relative (my--symbols-highlight-location
                                 highlighted (my--symbols-relative-location highlighted "/project/")))
                      (tail (my--symbols-path-tail relative 18))
                      (rendered (vertico--display-string (my--symbols-display-cell relative 18 'shadow tail)))
                      (start (string-search "target" rendered)))
                 (should start)
                 (should (string-prefix-p "…" rendered))
                 (should (memq 'my-completion-fuzzy-match (ensure-list (get-text-property start 'face rendered))))
                 (should (eq symbol (get-text-property 0 'consult--candidate highlighted))))))))

(ert-deftest my-completion-search-path-highlight-does-not-underline-entire-column ()
  (let* ((face 'my-completion-fuzzy-match)
         (path (concat (propertize "desc" 'face face) ".py:1"))
         (cell (my--symbols-display-cell path 24 'shadow (concat "./" path)))
         (row (vertico--display-string cell)))
    (should (equal (substring-no-properties cell) "desc.py:1"))
    (dotimes (i (length row))
      (should (eq (not (null (memq face (ensure-list (get-text-property i 'face row)))))
                  (and (<= 2 i) (< i 6)))))))

(ert-deftest my-completion-search-toggle-starts-ranked-results-at-best-match ()
  (with-temp-buffer
    (setq-local completion-styles '(orderless))
    (let* ((my-completion-search-default 'normal)
           (vertico--candidates '("calculate_bonus" "calc_bonus"))
           (vertico--index 0) (vertico--input nil) (vertico--lock-groups nil)
           (vertico--lock-candidate nil) (consult--narrow ?F) (updates 0))
      (insert "cb")
      (my--completion-search-setup 'project-symbols (lambda () (cl-incf updates)))
      (cl-letf (((symbol-function 'minibuffer-contents-no-properties) #'buffer-string)
                ((symbol-function 'vertico--update)
                 (lambda (&rest _) (setq vertico--candidates (reverse vertico--candidates) vertico--index 0)))
                ((symbol-function 'vertico--exhibit) #'ignore)
                ((symbol-function 'vertico--goto) (lambda (index) (setq vertico--index index))))
               (my--completion-search-toggle)
               (should (my--completion-search-fuzzy-p))
               (should (= vertico--index 0))
               (should (equal (nth vertico--index vertico--candidates) "calc_bonus"))
               (my--completion-search-toggle)
               (should-not (my--completion-search-fuzzy-p))
               (should (equal (nth vertico--index vertico--candidates) "calc_bonus"))
               (should (equal (buffer-string) "cb"))
               (should (eq consult--narrow ?F))
               (should (= updates 2))))))

(ert-deftest my-completion-search-symbols-rank-from-top-after-query-edit ()
  (dolist (order '(kind source))
    (with-temp-buffer
      (let* ((my--symbols-view (list :order order))
             (my--symbols-filter-signature '("" nil fuzzy))
             (my--symbols-opening-offset 1)
             (vertico--candidates '("description" "DEFAULT_LIMIT — desc.py:1"))
             (vertico--index 1)
             (vertico-count 10)
             (vertico--hilit #'identity)
             (vertico--metadata nil)
             (consult--narrow nil)
             (my--completion-search-session 'buffer-symbols)
             (my--completion-search-mode 'fuzzy)
             (my-completion-fuzzy-backend 'flx))
        (cl-letf (((symbol-function 'minibuffer-contents-no-properties) (lambda () "desc"))
                  ((symbol-function 'vertico--affixate)
                   (lambda (candidates) (mapcar (lambda (c) (list c "" "")) candidates)))
                  ((symbol-function 'vertico-next) (lambda (n) (cl-incf vertico--index n))))
          (my--symbols-update-filter #'ignore)
          (should (= vertico--index 0))
          (let ((lines (my--symbols-arrange-body)))
            (should (= 2 (length lines)))
            (should (string-prefix-p "description" (car lines))))
          (my--symbols-next-group 1)
          (should (= vertico--index 1))
          (my--symbols-update-filter #'ignore)
          (should (= vertico--index 1))
          (should (= 2 (length (my--symbols-arrange-body)))))))))

(ert-deftest my-completion-search-counts-use-current-engine-independent-of-kind-predicate ()
  (with-temp-buffer
    (let* ((candidates (my--test-symbols-presentation-candidates))
           (view (plist-get (my--project-symbols-interface candidates) :view))
           (minibuffer-completion-table (my--test-completion-search-table candidates))
           (consult--narrow ?M))
      (my--completion-search-setup 'project-symbols #'ignore)
      (my--completion-search-set-mode 'fuzzy)
      (insert "function")
      (cl-letf (((symbol-function 'minibufferp) (lambda (&rest _) t))
                ((symbol-function 'minibuffer-prompt-end) (lambda () 1))
                ((symbol-function 'minibuffer-contents-no-properties) (lambda () "function")))
               (my--project-symbols-refresh-counts view)
               (should (= (gethash ?F (plist-get view :matches)) 1))
               (should (= (gethash ?M (plist-get view :matches) 0) 0))))))

(ert-deftest my-completion-search-counts-reuse-unnarrowed-vertico-matches ()
  (with-temp-buffer
    (let* ((candidates (my--test-symbols-presentation-candidates))
           (methods (cl-remove-if-not
                     (lambda (candidate) (eq (get-text-property 0 'consult--type candidate) ?M))
                     candidates))
           (view (plist-get (my--project-symbols-interface candidates) :view))
           (vertico--input '("method" . 6))
           (vertico--candidates methods)
           (consult--narrow nil))
      (insert "method")
      (cl-letf (((symbol-function 'minibufferp) (lambda (&rest _) t))
                ((symbol-function 'minibuffer-prompt-end) (lambda () 1))
                ((symbol-function 'minibuffer-contents-no-properties) (lambda () "method"))
                ((symbol-function 'completion-all-completions)
                 (lambda (&rest _) (ert-fail "The picker rescored an up-to-date result"))))
        (my--project-symbols-refresh-counts view t)
        (should (= 2 (plist-get view :match-count)))
        (should (= 2 (gethash ?M (plist-get view :matches))))))))
