(ert-deftest my-documentation-long-fences-with-trailing-whitespace-render ()
  (require 'lsp-mode)
  (require 'markdown-mode)
  (require 'python)
  (let* ((my--documentation-source-mode 'python-mode)
         (fence (make-string 11 ?`))
         (markdown (concat fence "python\n>>> number = 42\n" fence "  \n\n"
                           "Ordinary prose: return example.\n\n"
                           fence "python\n>>> from dataclasses import make_dataclass\n"
                           ">>> value = \"hello\"\n" fence "\t \n\n"
                           "~~~elisp\n(defun greet () \"world\")\n~~~  \n"))
         (rendered (lsp--render-string markdown "markdown")))
    (should-not (string-match-p "^[`~]\\{3,\\}" rendered))
    (dolist (probe '(("from dataclasses" . font-lock-keyword-face)
                     ("\"hello\"" . font-lock-string-face)
                     ("defun greet" . font-lock-keyword-face)))
      (let ((position (string-match (regexp-quote (car probe)) rendered)))
        (should position)
        (should (memq (cdr probe) (ensure-list (get-text-property position 'face rendered))))))
    (let ((position (string-match "return example" rendered)))
      (should position)
      (should-not (memq 'font-lock-keyword-face (ensure-list (get-text-property position 'face rendered)))))))

(ert-deftest my-documentation-fence-normalization-preserves-literal-content ()
  (let* ((text (concat "Prose with trailing spaces.  \n"
                       "````python  \n"
                       "value = 'keep trailing spaces'  \n"
                       "```  \n"        ; Shorter literal fence inside the block.
                       "~~~  \n"        ; Different marker is literal content.
                       "````python  \n" ; Not a closing fence: nonblank suffix.
                       "    ````  \n"   ; Indented code, not a closing fence.
                       "`````\t \n"
                       "After the block.  \n"))
         (expected (replace-regexp-in-string "^`````\t $" "`````" text)))
    (with-temp-buffer
      (insert text)
      (my--documentation-normalize-closing-fences)
      (should (equal (buffer-string) expected))
      (my--documentation-normalize-closing-fences)
      (should (equal (buffer-string) expected)))))

(ert-deftest my-documentation-python-examples-use-parser-without-hooks ()
  (require 'lsp-mode)
  (require 'markdown-mode)
  (require 'python)
  (let ((treesit-extra-load-path
         (cons (or (getenv "DOOM_TREE_SITTER_DIR")
                   (expand-file-name "~/.emacs.d/.local/etc/tree-sitter"))
               (bound-and-true-p treesit-extra-load-path))))
    (skip-unless (and (fboundp 'python-ts-mode) (treesit-ready-p 'python t)))
    (let* ((my--documentation-source-mode 'python-mode)
           (python-mode-hook (list (lambda () (ert-fail "Python editing hooks must not run"))))
           (python-ts-mode-hook (list (lambda () (ert-fail "Python TS editing hooks must not run"))))
           (snippet ">>> d = {\"col1\": [1, 2], \"col2\": [3, 4]}\n>>> df = pd.DataFrame(data=d)\n>>> df\n   col1  col2\n0     1     3\n1     2     4\n")
           (rendered (lsp--render-string (concat "```python\n" snippet "```\n") "markdown")))
      (dolist (probe '(("1, 2" . font-lock-number-face)
                       ("DataFrame" . font-lock-function-call-face)
                       ("col1" . font-lock-string-face)))
        (let ((position (string-match (regexp-quote (car probe)) rendered)))
          (should position)
          (should (memq (cdr probe) (ensure-list (get-text-property position 'face rendered))))))
      (should (string-match-p (regexp-quote (string-trim-right snippet)) rendered)))))

(ert-deftest my-documentation-python-highlighting-falls-back-without-grammar ()
  (require 'lsp-mode)
  (require 'markdown-mode)
  (require 'python)
  (cl-letf (((symbol-function 'treesit-ready-p) (lambda (&rest _) nil)))
    (should (eq (my--documentation-code-mode 'python-ts-mode) 'python-mode))
    (let* ((my--documentation-source-mode 'python-mode)
           (python-mode-hook (list (lambda () (ert-fail "Fallback hooks must not run"))))
           (rendered (lsp--render-string "```python\ndef f():\n    return \"hello\"\n```\n" "markdown")))
      (should (memq 'font-lock-string-face
                    (ensure-list (get-text-property (string-match "hello" rendered) 'face rendered)))))))

(ert-deftest my-documentation-highlighter-leaves-ordinary-markdown-alone ()
  (let ((my-documentation-code-rendering nil) called)
    (my--documentation-fontify-code-a
     (lambda (&rest args) (setq called args)) "python" 10 20)
    (should (equal called '("python" 10 20)))))


(ert-deftest my-documentation-reading-view-does-not-resolve-example-identifiers ()
  (require 'lsp-mode)
  (with-temp-buffer
    (lsp-help-mode)
    (let ((inhibit-read-only t)) (insert "pd.Series np.array"))
    (cl-letf (((symbol-function 'lsp-request)
               (lambda (&rest _) (ert-fail "Help must not query example identifiers")))
              ((symbol-function '+lookup/documentation)
               (lambda () (ert-fail "Help must not trigger a source lookup"))))
      (should-error (my/documentation) :type 'user-error)
      (should-error (my/documentation '(4)) :type 'user-error))))

(ert-deftest my-documentation-source-destinations-deduplicate-location-links ()
  (let* ((location '(:uri "file:///definition" :range (:start (:line 2 :character 4))))
         (link '(:targetUri "file:///definition"
                 :originSelectionRange (:start (:line 99 :character 0))
                 :targetSelectionRange (:start (:line 2 :character 4))))
         (other '(:uri "file:///definition" :range (:start (:line 8 :character 4)))))
    (should (equal (my--documentation-unique-locations (list location link other))
                   (list location other)))))

(ert-deftest my-documentation-reading-keys-do-not-change-source-bindings ()
  (require 'evil)
  (require 'lsp-mode)
  (let ((definition 'my-test-original-definition))
    (with-temp-buffer
      (evil-local-mode 1)
      (evil-local-set-key 'normal (kbd "g d") definition)
      (evil-normal-state)
      (should (eq (key-binding (kbd "g d")) definition))
      (should (eq (key-binding (kbd "K")) #'my/documentation)))
    (dolist (source-mode '(python-mode ess-r-mode rust-mode emacs-lisp-mode
                          go-mode c-mode c++-mode java-mode))
      (with-temp-buffer
        (lsp-help-mode)
        (setq-local my-documentation-lsp-context (list :mode source-mode))
        (my--documentation-mode 1)
        (evil-local-mode 1)
        (dolist (state '(normal motion))
          (funcall (intern (format "evil-%s-state" state)))
          (should (eq (key-binding (kbd "g d")) #'ignore))
          (should (eq (key-binding (kbd "K")) #'my/documentation))
          (should-error (call-interactively (key-binding (kbd "K")))
                        :type 'user-error))))))
