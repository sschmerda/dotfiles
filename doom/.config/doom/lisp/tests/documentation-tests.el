;;; documentation-tests.el --- Documentation window behavior -*- lexical-binding: t; -*-
;; Run from DOOMDIR: emacs -Q --batch -l lisp/tests/documentation-tests.el
;;   -f ert-run-tests-batch-and-exit
(require 'ert)
(require 'cl-lib)
(let ((build (expand-file-name
              (format "~/.emacs.d/.local/straight/build-%d.%d"
                      emacs-major-version emacs-minor-version))))
  (dolist (directory (directory-files build t "^[^.]"))
    (when (file-directory-p directory) (add-to-list 'load-path directory))))
(load (expand-file-name "../documentation-config.el"
                        (file-name-directory (or load-file-name buffer-file-name))) nil t)

(defvar my-test-doc-calls 0)
(defvar my-test-doc-buffer nil)
(defvar my-test-doc-select t)
(defvar my-test-doc-display t)
(defvar my-test-doc-rewrite t)
(defvar my-test-doc-same-window nil)
(defvar my-test-doc-call-buffers nil)

(ert-deftest my-documentation-code-backgrounds-follow-help-surface-locally ()
  (require 'markdown-mode)
  (require 'solaire-mode)
  (let ((original (face-attribute 'markdown-code-face :background)))
    (with-temp-buffer
      (setq-local solaire-mode t)
      (cl-letf (((symbol-function 'face-background)
                 (lambda (face &rest _)
                   (if (eq face 'solaire-default-face) "#403050" "#201030"))))
        (my--documentation-style-code-backgrounds)
        (dolist (face '(markdown-code-face markdown-pre-face markdown-inline-code-face))
          (should (equal (cadr (assq face face-remapping-alist))
                         '(:background "#403050"))))
        ;; Fullscreen turns Solaire off; replace, rather than stack, the remaps.
        (setq-local solaire-mode nil)
        (my--documentation-style-code-backgrounds)
        (should (= (length my-documentation-code-background-cookies) 3))
        (dolist (face '(markdown-code-face markdown-pre-face markdown-inline-code-face))
          (should (equal (cadr (assq face face-remapping-alist))
                         '(:background "#201030"))))))
    (should (equal (face-attribute 'markdown-code-face :background) original))))

(ert-deftest my-documentation-library-navigation-preserves-editing-state ()
  (require 'view)
  (dolist (state '(editable read-only viewing))
    (with-temp-buffer
      (when (eq state 'read-only) (setq buffer-read-only t))
      (when (eq state 'viewing) (view-mode 1))
      (should
       (eq (my--documentation-library-view-a
            (lambda () (view-mode 1) 'connected))
           'connected))
      (should (eq (not (null view-mode)) (eq state 'viewing)))
      (should (eq buffer-read-only (not (eq state 'editable)))))))

(ert-deftest my-documentation-history-refresh-does-not-add-a-step ()
  (require 'lsp-mode)
  (let ((source (generate-new-buffer " *documentation refresh origin*")))
    (unwind-protect
        (save-window-excursion
          (switch-to-buffer source)
          (let ((my--documentation-render-context (list :source source))
                (my--documentation-source-mode 'fundamental-mode))
            (lsp--display-contents "First topic")
            (select-window (get-buffer-window "*lsp-help*"))
            (lsp--display-contents "First topic")
            (should-not help-xref-stack)
            (lsp--display-contents "Second topic")
            (should (= (length help-xref-stack) 1))
            (help-go-back)
            (should (string-match-p "First topic" (buffer-string)))
            (should-not help-xref-stack)
            (should (= (length help-xref-forward-stack) 1))
            ;; Same hover text, but a fresh context/position for the same topic.
            (let ((my--documentation-render-context
                   (list :source source :params '(:position (:line 2 :character 3)))))
              (lsp--display-contents "First topic"))
            (should-not help-xref-stack)
            (should (= (length help-xref-forward-stack) 1))
            (help-go-forward)
            (should (string-match-p "Second topic" (buffer-string)))
            (should (= (length help-xref-stack) 1))
            (help-go-back)
            (should-error (help-go-back) :type 'user-error)))
      (when (get-buffer "*lsp-help*") (kill-buffer "*lsp-help*"))
      (kill-buffer source))))

(ert-deftest my-documentation-evil-jump-keys-and-gui-tab ()
  (require 'evil)
  (require 'lsp-mode)
  (with-temp-buffer
    (lsp-help-mode)
    (evil-local-mode 1)
    (evil-motion-state)
    (my--documentation-mode 1)
    (should (eq (key-binding (kbd "C-=")) #'text-scale-increase))
    (should (eq (key-binding (kbd "C--")) #'text-scale-decrease))
    (call-interactively (key-binding (kbd "C-=")))
    (should (= text-scale-mode-amount 1))
    (call-interactively (key-binding (kbd "C--")))
    (should (= text-scale-mode-amount 0))
    (should (eq (key-binding (kbd "C-o")) #'help-go-back))
    (should (eq (key-binding (kbd "C-i")) #'help-go-forward))
    (should (eq (key-binding (kbd "<C-i>")) #'help-go-forward))
    (should (eq (key-binding (kbd "C-o")) (key-binding (kbd "<"))))
    (should (eq (key-binding (kbd "<C-i>")) (key-binding (kbd ">"))))
    (should (eq (key-binding (kbd "<tab>")) #'forward-button))
    (should (eq (key-binding (kbd "<backtab>")) #'backward-button))
    (should (eq (key-binding (kbd "g d")) #'ignore))
    (should (eq (key-binding (kbd "K")) #'my/documentation))))

(ert-deftest my-documentation-native-lsp-history-preserves-layout-and-context ()
  (require 'lsp-mode)
  (require 'markdown-mode)
  (save-window-excursion
    (let ((source (generate-new-buffer " *documentation history source*"))
          (help (get-buffer-create "*lsp-help*"))
          (display-buffer-alist '(("^\\*lsp-help\\*$"
                                   display-buffer-at-bottom (window-height . 0.3))))
          (saved-state (frame-parameter nil 'my-documentation)))
      (unwind-protect
          (progn
            (delete-other-windows)
            (switch-to-buffer source)
            (with-current-buffer help
              (lsp-help-mode)
              (setq help-xref-stack nil help-xref-forward-stack nil help-xref-stack-item nil))
            (let* ((source-window (selected-window))
                   (configuration (current-window-configuration))
                   (first-context (list :source source :params '(:position (:line 1 :character 0))))
                   (second-context (list :source source :params '(:position (:line 2 :character 0))))
                   (my--documentation-source-mode 'python-mode)
                   (my--documentation-render-context first-context))
              (lsp--display-contents "First page: a cached type description.")
              (select-window (get-buffer-window help))
              (goto-char 8)
              (let ((window (selected-window)) (edges (window-edges)))
                (let ((my--documentation-render-context second-context))
                  (lsp--display-contents "Second page: another type description."))
                (should (eq window (get-buffer-window help)))
                (should (equal edges (window-edges window)))
                (cl-letf (((symbol-function 'lsp-request)
                           (lambda (&rest _) (ert-fail "History must not request LSP again"))))
                  (help-go-back)
                  (should (string-match-p "First page" (buffer-string)))
                  (should (= (point) 8))
                  (should (equal my-documentation-lsp-context first-context))
                  (should (equal edges (window-edges window)))
                  (help-go-forward)
                  (should (string-match-p "Second page" (buffer-string)))
                  (should (equal my-documentation-lsp-context second-context))))
              ;; The same native history commands must retain the expanded view.
              (set-frame-parameter nil 'my-documentation
                                   (list :configuration configuration :source source-window
                                         :source-buffer source :point 1 :window (selected-window)
                                         :buffer help :time (float-time)))
              (my--documentation-expand (selected-frame) (frame-parameter nil 'my-documentation))
              (let ((edges (window-edges)))
                (help-go-back)
                (should (= (length (window-list)) 1))
                (should (equal edges (window-edges)))
                (should olivetti-mode)
                (help-go-forward)
                (should (= (length (window-list)) 1))
                (should olivetti-mode))
              ;; Following a new branch after Back discards the old forward page.
              (help-go-back)
              (lsp--display-contents "Third page: a new branch.")
              (should-not help-xref-forward-stack)
              (should-error (help-go-forward) :type 'user-error)))
        (set-frame-parameter nil 'my-documentation saved-state)
        (kill-buffer help)
        (kill-buffer source)))))

(ert-deftest my-documentation-inline-code-links-are-buttons ()
  (require 'lsp-mode)
  (require 'markdown-mode)
  (with-temp-buffer
    (insert (lsp--render-string "See [`Generator`](https://example.org/type)." "markdown"))
    (goto-char (point-min))
    (search-forward "Generator")
    (backward-char 2)
    (should (button-at (point)))
    (let (followed)
      (cl-letf (((symbol-function 'lsp--document-link-handle-target)
                 (lambda (url) (setq followed url))))
        (push-button))
      (should (equal followed "https://example.org/type")))))

(defun my-test-doc-backend ()
  (interactive)
  (cl-incf my-test-doc-calls)
  (push (current-buffer) my-test-doc-call-buffers)
  (when my-test-doc-display
    (when my-test-doc-rewrite
      (with-current-buffer my-test-doc-buffer
      (help-mode)
      (let ((inhibit-read-only t))
        (erase-buffer) (insert (format "Documentation %d" my-test-doc-calls)))))
    (let ((window (if my-test-doc-same-window
                      (progn (switch-to-buffer my-test-doc-buffer) (selected-window))
                    (display-buffer my-test-doc-buffer
                                  '(display-buffer-at-bottom (window-height . 0.3))))))
      (when my-test-doc-select (select-window window)))))

(defmacro my-test-with-documentation (&rest body)
  `(save-window-excursion
     (let ((source (generate-new-buffer " *doc source*"))
           (my-test-doc-buffer (generate-new-buffer "*doc test*"))
           (my-test-doc-calls 0) (my-test-doc-select t) (my-test-doc-display t)
           (my-test-doc-same-window nil) (my-test-doc-call-buffers nil)
           (my-test-doc-rewrite t)
           (my-documentation-repeat-delay 1.0))
       (unwind-protect
           (cl-letf (((symbol-function '+lookup/documentation) #'my-test-doc-backend))
             (delete-other-windows) (switch-to-buffer source)
             (insert "example") (goto-char (point-min))
             ,@body)
         (my--documentation-clear (selected-frame))
         (kill-buffer source) (kill-buffer my-test-doc-buffer)))))

(ert-deftest my-documentation-reopen-preserves-page-and-restores-layout ()
  (my-test-with-documentation
   (my/documentation)
   (goto-char 5)
   (setq-local help-xref-stack '((3 ignore)))
   (let ((contents (buffer-string)))
     (my/documentation-quit)
     (should (eq (current-buffer) source))
     (my/documentation-reopen)
     (should (eq (current-buffer) my-test-doc-buffer))
     (should (= (point) 5))
     (should (equal (buffer-string) contents))
     (should (equal help-xref-stack '((3 ignore))))
     (should-not header-line-format)
     (my/documentation-quit)
     (split-window-right)
     (my/documentation-reopen-centered)
     (should (= (length (window-list)) 1))
     (should (bound-and-true-p olivetti-mode))
     (should-not header-line-format)
     (should (string-match-p "Documentation" (my--documentation-mode-line-label)))
     (should (= (point) 5))
     ;; Reopening an already expanded page must preserve its original layout.
     (my/documentation-reopen-centered)
     (my/documentation-quit)
     (should (= (length (window-list)) 2))
     ;; Switching from fullscreen to the bottom popup restores the two splits.
     (my/documentation-reopen-centered)
     (my/documentation-reopen)
     (should (= (length (window-list)) 3))
     (should-not header-line-format)
     (should (equal help-xref-stack '((3 ignore))))
     (my/documentation-quit)
     (should (= (length (window-list)) 2))
     (should (= my-test-doc-calls 1)))))

(ert-deftest my-documentation-label-identifies-topic-source-and-server ()
  (require 'lsp-mode)
  (let ((source (generate-new-buffer " *documentation header origin*")))
    (unwind-protect
        (with-temp-buffer
          (setq-local my-documentation-lsp-context (list :source source :symbol "thread_rng"))
          (cl-letf (((symbol-function 'lsp-workspaces)
                     (lambda () (list (make-lsp--workspace
                                       :client (make-lsp--client :server-id 'rust-analyzer))))))
            (should (equal (my--documentation-page-label)
                           "Documentation: thread_rng · rust-analyzer"))
            (let* ((label (my--documentation-mode-line-label))
                   (position (string-match "Documentation" label)))
              (should position)
              (should (equal (get-text-property position 'face label)
                             '(mode-line-emphasis bold))))))
      (kill-buffer source))))

(ert-deftest my-documentation-open-source-from-fullscreen-restores-editing-layout ()
  (require 'lsp-mode)
  (let ((file (make-temp-file "documentation-open-source-" nil ".py"
                             "# header\ndef example(): pass\n")))
    (unwind-protect
        (my-test-with-documentation
         (split-window-right)
         (my/documentation)
         (lsp-help-mode)
         (setq-local my-documentation-lsp-context (list :source source :symbol "example" :params '(:origin t)))
         (let ((last-command 'my/documentation)) (my/documentation))
         (should (= (length (window-list)) 1))
         (cl-letf (((symbol-function 'my--documentation-lsp-request)
                    (lambda (_ method params)
                      (should (equal method "textDocument/definition"))
                      (should (equal params '(:origin t)))
                      (list :uri (concat "file://" file)
                            :range '(:start (:line 1 :character 4) :end (:line 1 :character 11))))))
           (my/documentation-open-source))
         (should (= (length (window-list)) 2))
         (should (equal buffer-file-name file))
         (should (looking-at "example"))
         (should-not buffer-read-only)
         (should-not (bound-and-true-p my--documentation-mode))
         (should-not (frame-parameter nil 'my-documentation)))
      (when-let ((buffer (get-file-buffer file))) (kill-buffer buffer))
      (delete-file file))))

(ert-deftest my-documentation-fullscreen-restores-solaire ()
  (require 'solaire-mode)
  (my-test-with-documentation
   (my/documentation)
   (setq-local solaire-mode t)
   (cl-letf (((symbol-function 'solaire-mode)
              (lambda (arg) (setq-local solaire-mode (> arg 0)))))
     (let ((last-command 'my/documentation)) (my/documentation))
     (should-not solaire-mode)
     ;; A fresh renderer can re-enable Solaire; fullscreen must suppress it again.
     (setq-local solaire-mode t)
     (my--documentation-update-presentation)
     (should-not solaire-mode)
     (my/documentation-quit)
     (should (buffer-local-value 'solaire-mode my-test-doc-buffer)))))

(ert-deftest my-documentation-repeat-and-restore ()
  (my-test-with-documentation
   (split-window-right)
   (let ((before (window-state-get (frame-root-window) t))
         (original-mode-line (buffer-local-value 'mode-line-format my-test-doc-buffer)))
     (my/documentation)
     (should (= my-test-doc-calls 1))
     (should (= (length (window-list)) 3))
     (let ((last-command 'my/documentation)) (my/documentation))
     (should (= my-test-doc-calls 1))
     (should (= (length (window-list)) 1))
     (should (eq (current-buffer) my-test-doc-buffer))
     (should (bound-and-true-p olivetti-mode))
     (should-not header-line-format)
     (should (string-match-p "Documentation" (my--documentation-mode-line-label)))
     (should (equal mode-line-format
                    '((:eval (when (fboundp 'doom-modeline-segment--bar)
                                    (doom-modeline-segment--bar)))
                      " " (:eval (my--documentation-mode-line-label)))))
     (my/documentation-quit)
     (should (equal before (window-state-get (frame-root-window) t)))
     (should (equal original-mode-line
                    (buffer-local-value 'mode-line-format my-test-doc-buffer)))
     (should-not (buffer-local-value 'my--documentation-mode my-test-doc-buffer)))))

