(ert-deftest my-documentation-lsp-resolves-signature-types-in-source-context ()
  (require 'lsp-mode)
  (let* ((file (make-temp-file "documentation-signature-" nil ".rs"
                                "fn sample() -> Generator {}\n"))
         (uri (concat "file://" file))
         (source (generate-new-buffer " *documentation lsp source*"))
         (final '(:uri "file:///resolved-type.rs"
                  :range (:start (:line 4 :character 0) :end (:line 4 :character 9))))
         calls)
    (unwind-protect
        (with-current-buffer source
          (setq-local lsp-mode t)
          (cl-letf (((symbol-function 'lsp-request)
                     (lambda (method params &rest _)
                       (should (eq (current-buffer) source))
                       (push method calls)
                       (should (equal method "textDocument/definition"))
                       (if (equal (plist-get (plist-get params :textDocument) :uri) uri)
                           (list final)
                         (list (list :targetUri uri
                                     :targetRange '(:start (:line 0 :character 0)
                                                    :end (:line 0 :character 26))
                                     :targetSelectionRange '(:start (:line 0 :character 3)
                                                             :end (:line 0 :character 9))))))))
            (should (equal (my--documentation-resolve-symbol
                            (list :source source :params '(:textDocument (:uri "file:///caller.rs")
                                                           :position (:line 0 :character 0)))
                            "Generator") final))
            (should (= (length calls) 2))))
      (kill-buffer source)
      (delete-file file))))

(ert-deftest my-documentation-lsp-workspace-fallback-and-missing-symbol ()
  (require 'lsp-mode)
  (with-temp-buffer
    (setq-local lsp-mode t)
    (let ((context (list :source (current-buffer) :params nil))
          (location '(:uri "file:///type.py"
                      :range (:start (:line 0 :character 0) :end (:line 0 :character 4)))))
      (cl-letf (((symbol-function 'lsp-request)
                 (lambda (method params &rest _)
                   (when (and (equal method "workspace/symbol")
                              (equal (plist-get params :query) "Result"))
                     (list (list :name "Result" :location location)
                           (list :name "ResultOther" :location location))))))
        (should (equal (my--documentation-resolve-symbol context "Result") location))
        (should-error (my--documentation-resolve-symbol context "Missing") :type 'user-error)))))

(defun my-test-doc-backend ()
  (interactive)
  (cl-incf my-test-doc-calls)
  (push (current-buffer) my-test-doc-call-buffers)
  (when my-test-doc-display
    (when my-test-doc-rewrite
      (with-current-buffer my-test-doc-buffer
      (help-mode)
      (let ((inhibit-read-only t))
        (erase-buffer) (insert (format "Documentation %d" my-test-doc-calls)))))
    (let ((window (if my-test-doc-same-window
                      (progn (switch-to-buffer my-test-doc-buffer) (selected-window))
                    (display-buffer my-test-doc-buffer
                                  '(display-buffer-at-bottom (window-height . 0.3))))))
      (when my-test-doc-select (select-window window)))))

(defmacro my-test-with-documentation (&rest body)
  `(save-window-excursion
     (let ((source (generate-new-buffer " *doc source*"))
           (my-test-doc-buffer (generate-new-buffer "*doc test*"))
           (my-test-doc-calls 0) (my-test-doc-select t) (my-test-doc-display t)
           (my-test-doc-same-window nil) (my-test-doc-call-buffers nil)
           (my-test-doc-rewrite t)
           (my-documentation-repeat-delay 1.0))
       (unwind-protect
           (cl-letf (((symbol-function '+lookup/documentation) #'my-test-doc-backend))
             (delete-other-windows) (switch-to-buffer source)
             (insert "example") (goto-char (point-min))
             ,@body)
         (my--documentation-clear (selected-frame))
         (kill-buffer source) (kill-buffer my-test-doc-buffer)))))

(ert-deftest my-documentation-reopen-preserves-page-and-restores-layout ()
  (my-test-with-documentation
   (my/documentation)
   (goto-char 5)
   (setq-local help-xref-stack '((3 ignore)))
   (let ((contents (buffer-string)))
     (my/documentation-quit)
     (should (eq (current-buffer) source))
     (my/documentation-reopen)
     (should (eq (current-buffer) my-test-doc-buffer))
     (should (= (point) 5))
     (should (equal (buffer-string) contents))
     (should (equal help-xref-stack '((3 ignore))))
     (should-not header-line-format)
     (my/documentation-quit)
     (split-window-right)
     (my/documentation-reopen-centered)
     (should (= (length (window-list)) 1))
     (should (bound-and-true-p olivetti-mode))
     (should (string-prefix-p " Documentation" (car header-line-format)))
     (should (= (point) 5))
     ;; Reopening an already expanded page must preserve its original layout.
     (my/documentation-reopen-centered)
     (my/documentation-quit)
     (should (= (length (window-list)) 2))
     ;; Switching from fullscreen to the bottom popup restores the two splits.
     (my/documentation-reopen-centered)
     (my/documentation-reopen)
     (should (= (length (window-list)) 3))
     (should-not header-line-format)
     (should (equal help-xref-stack '((3 ignore))))
     (my/documentation-quit)
     (should (= (length (window-list)) 2))
     (should (= my-test-doc-calls 1)))))

(ert-deftest my-documentation-header-identifies-topic-source-and-server ()
  (require 'lsp-mode)
  (let ((source (generate-new-buffer " *documentation header origin*")))
    (unwind-protect
        (with-temp-buffer
          (setq-local my-documentation-lsp-context
                      (list :source source :symbol "thread_rng"
                            :params '(:position (:line 87 :character 0))))
          (cl-letf (((symbol-function 'lsp-workspaces)
                     (lambda () (list (make-lsp--workspace
                                       :client (make-lsp--client :server-id 'rust-analyzer))))))
            (should (equal (my--documentation-header-label)
                           "Documentation: thread_rng · rust-analyzer"))
            (setq-local my-documentation-source-page '(:path "/crate/thread.rs"))
            (should (equal (my--documentation-header-label)
                           "Source: /crate/thread.rs:88 · rust-analyzer"))))
      (kill-buffer source))))

(ert-deftest my-documentation-open-source-from-fullscreen-restores-editing-layout ()
  (require 'lsp-mode)
  (let ((file (make-temp-file "documentation-open-source-" nil ".py"
                             "# header\ndef example(): pass\n")))
    (unwind-protect
        (my-test-with-documentation
         (split-window-right)
         (my/documentation)
         (lsp-help-mode)
         (setq-local my-documentation-lsp-context (list :source source :symbol "example" :params '(:origin t)))
         (let ((last-command 'my/documentation)) (my/documentation))
         (should (= (length (window-list)) 1))
         (cl-letf (((symbol-function 'my--documentation-lsp-request)
                    (lambda (_ method params)
                      (should (equal method "textDocument/definition"))
                      (should (equal params '(:origin t)))
                      (list :uri (concat "file://" file)
                            :range '(:start (:line 1 :character 4) :end (:line 1 :character 11))))))
           (my/documentation-open-source))
         (should (= (length (window-list)) 2))
         (should (equal buffer-file-name file))
         (should (looking-at "example"))
         (should-not buffer-read-only)
         (should-not (bound-and-true-p my--documentation-mode))
         (should-not (frame-parameter nil 'my-documentation)))
      (when-let ((buffer (get-file-buffer file))) (kill-buffer buffer))
      (delete-file file))))

(ert-deftest my-documentation-fullscreen-restores-solaire ()
  (require 'solaire-mode)
  (my-test-with-documentation
   (my/documentation)
   (setq-local solaire-mode t)
   (cl-letf (((symbol-function 'solaire-mode)
              (lambda (arg) (setq-local solaire-mode (> arg 0)))))
     (let ((last-command 'my/documentation)) (my/documentation))
     (should-not solaire-mode)
     ;; A fresh renderer can re-enable Solaire; fullscreen must suppress it again.
     (setq-local solaire-mode t)
     (my--documentation-update-header)
     (should-not solaire-mode)
     (my/documentation-quit)
     (should (buffer-local-value 'solaire-mode my-test-doc-buffer)))))

(ert-deftest my-documentation-repeat-and-restore ()
  (my-test-with-documentation
   (split-window-right)
   (let ((before (window-state-get (frame-root-window) t)))
     (my/documentation)
     (should (= my-test-doc-calls 1))
