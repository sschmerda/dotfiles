                  (setf (plist-get view :order-overlay) overlay)
                  (my--symbols-show-order view)
                  (should (string-search "Incomplete: 1" (overlay-get overlay 'before-string)))
                  (delete-overlay overlay)))
              (should (string-search "broken.py: server error" (my--symbols-panel-text view 'errors))))))
      (delete-directory root t))))

(ert-deftest my-project-symbols-excludes-environments-and-outside-links ()
  (let ((root (file-name-as-directory (make-temp-file "project-symbols-" t)))
        (outside (make-temp-file "external-symbols-" t))
        (cache (make-hash-table :test #'equal)))
    (unwind-protect
        (progn
          (dolist (name '("src/main.py" ".venv/hidden.py" "build/generated.py"
                          "custom-env/pkg/hidden.py" "conda-env/pkg/hidden.py"))
            (let ((file (expand-file-name name root)))
              (make-directory (file-name-directory file) t)
              (write-region "" nil file nil 'silent)))
          (write-region "" nil (expand-file-name "custom-env/pyvenv.cfg" root) nil 'silent)
          (make-directory (expand-file-name "conda-env/conda-meta" root))
          (write-region "" nil (expand-file-name "external.py" outside) nil 'silent)
          (make-symbolic-link outside (expand-file-name "linked" root))
          (should-not (my--project-symbols-excluded-p
                       (expand-file-name "src/main.py" root) root cache))
          (dolist (name '(".venv/hidden.py" "build/generated.py" "custom-env/pkg/hidden.py"
                          "conda-env/pkg/hidden.py" "linked/external.py" "../outside.py"))
            (should (my--project-symbols-excluded-p (expand-file-name name root) root cache))))
      (delete-directory root t)
      (delete-directory outside t))))

(ert-deftest my-project-symbols-flattens-lsp-hierarchy ()
  (let* ((uri "file:///project/source.py")
         (response (json-parse-string
                    "[{\"name\":\"Example\",\"kind\":5,\"selectionRange\":{\"start\":{\"line\":0,\"character\":6},\"end\":{\"line\":0,\"character\":13}},\"children\":[{\"name\":\"method\",\"kind\":6,\"selectionRange\":{\"start\":{\"line\":1,\"character\":8},\"end\":{\"line\":1,\"character\":14}}}]},{\"name\":\"imported\",\"kind\":12,\"location\":{\"uri\":\"file:///external/package.py\",\"range\":{}}}]"
                    :object-type (if lsp-use-plists 'plist 'hash-table)))
         (symbols (my--project-symbols-normalize response uri)))
    (should (equal (mapcar (lambda (s) (lsp-get s :name)) symbols) '("Example" "method")))
    (should (equal (lsp-get (cadr symbols) :containerName) "Example"))
    (should (= (lsp-get (car symbols) :my-depth) 0))
    (should (= (lsp-get (cadr symbols) :my-depth) 1))
    (should (equal (lsp-get (lsp-get (car symbols) :location) :uri) uri))
    (should (= 6 (lsp-get (cadr symbols) :kind)))))

(ert-deftest my-project-symbols-closes-temporary-documents-on-error-and-quit ()
  (dolist (failure '(error quit))
    (let ((file (make-temp-file "project-symbols-" nil ".py" "def example(): pass\n"))
          (workspace (make-lsp--workspace :client (make-lsp-client :server-id 'test)))
          calls)
      (unwind-protect
          (cl-letf (((symbol-function 'lsp-notify)
                     (lambda (method _params) (push method calls)))
                    ((symbol-function 'lsp-request)
                     (lambda (&rest _) (signal failure '("test interruption")))))
            (condition-case nil
                (my--project-symbols-document file workspace "python" nil)
              (error nil) (quit nil))
            (should (equal (nreverse calls)
                           '("textDocument/didOpen" "textDocument/didClose")))
            (should-not (find-buffer-visiting file)))
        (delete-file file)))))

(ert-deftest my-project-symbols-keeps-open-documents-and-unsaved-text ()
  (with-temp-buffer
    (insert "unsaved definition")
    (let* ((workspace (make-lsp--workspace :client (make-lsp-client :server-id 'test)))
           (existing (current-buffer)) calls flushed)
      (setq-local lsp--buffer-workspaces (list workspace))
      (cl-letf (((symbol-function 'lsp-notify)
                 (lambda (method params) (push (cons method params) calls)))
                ((symbol-function 'lsp-request) (lambda (&rest _) nil))
                ((symbol-function 'lsp--flush-delayed-changes) (lambda () (setq flushed t))))
        (my--project-symbols-document "/project/unsaved.py" workspace "python" existing)
        (should flushed)
        (should-not calls)
        ;; An existing editor buffer not attached to this server is temporarily
        ;; opened with its unsaved contents, without saving or killing it.
        (setq-local lsp--buffer-workspaces nil)
        (my--project-symbols-document "/project/unsaved.py" workspace "python" existing)
        (let* ((opened (assoc "textDocument/didOpen" calls))
               (document (plist-get (cdr opened) :textDocument)))
          (should (equal (plist-get document :text) "unsaved definition")))
        (should (buffer-live-p existing))
        (should (buffer-modified-p))))))

(ert-deftest my-project-symbols-file-routing-uses-active-clients-only ()
  (let* ((client (make-lsp-client :server-id 'test-python :activation-fn (lsp-activate-on "python")))
         (workspace (make-lsp--workspace :client client)))
    (should (equal (seq-take (my--project-symbols-file-context "/project/main.py" (list workspace)) 2)
                   (list workspace "python")))
    (should-not (my--project-symbols-file-context "/project/notes.txt" (list workspace)))))

(ert-deftest my-project-symbols-unlisted-kinds-have-a-navigable-group ()
  (require 'vertico)
  (let* ((workspace (make-lsp--workspace :root "/project"))
         (group (consult--type-group consult-lsp-symbols-narrow))
         (my--symbols-view (list :order 'kind))
         (vertico--lock-groups nil)
         candidates visited)
    ;; A constructor between Field and Function used to create a nil group.
    (dolist (entry '(("a_field" . 8) ("b_constructor" . 9) ("c_function" . 12)))
      (let* ((symbol (lsp-make-symbol-information
                      :name (car entry) :kind (cdr entry)
                      :location (lsp-make-location
                                 :uri "file:///project/example.py"
                                 :range (lsp-make-range
                                         :start (lsp-make-position :line 0 :character 0)
                                         :end (lsp-make-position :line 0 :character 1)))))
             (candidate (my--project-symbols-candidate workspace symbol)))
        (should (characterp (get-text-property 0 'consult--type candidate)))
        (push candidate candidates)))
    (setq candidates (nreverse candidates))
    (dotimes (_ 4)
      (let* ((result (vertico--group-by group (copy-sequence candidates)))
             (vertico--groups (cdr result)))
        (push (funcall group (caar result) nil) visited)
        (my--symbols-next-group)))
    (should (equal (nreverse visited) '("Field" "Other" "Function" "Field")))
    (should (eq ?o (get-text-property 0 'consult--type (cadr candidates))))))
