;;; project-symbols-tests.el --- Project document symbol collection -*- lexical-binding: t; -*-

;; Match LSP_USE_PLISTS to the installed Doom package build, e.g.:
;; LSP_USE_PLISTS=true emacs -Q --batch -l this-file -f ert-run-tests-batch-and-exit
(require 'ert)
(require 'cl-lib)
;; Doom normally declares this dynamically scoped option before user config.
(defvar +nav-flash-exclude-commands nil)
(let ((build (or (getenv "DOOM_LSP_BUILD")
                 (expand-file-name
                  (format "~/.emacs.d/.local/straight/build-%d.%d/"
                          emacs-major-version emacs-minor-version)))))
  (dolist (directory (directory-files build t "^[^.]" t))
    (when (file-directory-p directory) (add-to-list 'load-path directory))))
(require 'consult-lsp)
(require 'projectile)
(load (expand-file-name "../project-symbols-config.el"
                        (file-name-directory load-file-name)) nil t)

(defun my--test-symbols-presentation-candidates ()
  "Return deliberately shuffled symbols with nesting and multiple files."
  (let ((workspace (make-lsp--workspace :root "/project")) candidates)
    (dolist (spec '(("z.py" "last" 12 20 21 0)
                    ("a.py" "second_method" 6 5 6 1)
                    ("a.py" "Container" 5 0 10 0)
                    ("a.py" "first_method" 6 2 3 1)
                    ("a.py" "early_function" 12 12 13 0)))
      (pcase-let ((`(,file ,name ,kind ,line ,end ,depth) spec))
        (let ((range (my--project-symbols-object
                      :start (my--project-symbols-object :line line :character 0)
                      :end (my--project-symbols-object :line end :character 0))))
          (push (my--project-symbols-candidate
                 workspace (my--project-symbols-object
                            :name name :kind kind :my-depth depth :my-range range
                            :location (my--project-symbols-object
                                       :uri (concat "file:///project/" file) :range range)))
                candidates))))
    candidates))

(ert-deftest my-symbols-orders-use-code-structure-instead-of-name-length ()
  (let* ((my-symbols-remember-order nil)
         (my-project-symbols-default-order 'kind)
         (candidates (my--test-symbols-presentation-candidates))
         (interface (my--project-symbols-interface candidates 'project))
         (view (plist-get interface :view))
         (group (plist-get interface :group))
         (names (lambda (items)
                  (mapcar (lambda (c) (lsp-get (get-text-property 0 'consult--candidate c) :name))
                          items))))
    (should (equal (funcall names (my--symbols-sort view candidates))
                   '("Container" "early_function" "last" "first_method" "second_method")))
    (setf (plist-get view :order) 'source)
    (let* ((sorted (my--symbols-sort view candidates))
           (affix (my--project-symbols-annotate-builder view)))
      (should (equal (funcall names sorted)
                     '("Container" "first_method" "second_method" "early_function" "last")))
      (should (equal (funcall group (car sorted) nil) "a.py"))
      (should (equal (funcall group (car (last sorted)) nil) "z.py"))
      (should (= (- (string-width (cadr (funcall affix (cadr sorted))))
                    (string-width (cadr (funcall affix (car sorted))))) 2))
      (setf (plist-get view :scope) 'buffer)
      (should-not (funcall group (car sorted) nil))
      ;; A filter returning a shuffled subset still follows the selected order.
      (should (equal (funcall names (my--symbols-sort view (list (nth 2 sorted) (nth 1 sorted))))
                     '("first_method" "second_method"))))))

(ert-deftest my-symbols-long-labels-keep-location-aligned-and-full-text-searchable ()
  (require 'vertico)
  (require 'orderless)
  (let ((completion-styles '(orderless))
        (completion-category-defaults nil) (completion-category-overrides nil)
        (orderless-style-dispatchers '(orderless-affix-dispatch))
        (parent (concat (make-string 90 ?P) "hidden_parent_tail"))
        (workspace (make-lsp--workspace :root "/project")))
    (dolist (mode '(kind source))
      (dolist (width '(60 120))
        (dolist (name (list "short" (concat (make-string 100 ?n) "hidden_name_tail")
                           (concat (make-string 60 ?界) "hidden_name_tail")))
          (dolist (depth '(0 2 50))
            (let* ((range (my--project-symbols-object
                           :start (my--project-symbols-object :line 0 :character 0)
                           :end (my--project-symbols-object :line 1 :character 0)))
                   (symbol (my--project-symbols-object
                            :name name :kind 12 :containerName parent :my-depth depth
                            :location (my--project-symbols-object
                                       :uri "file:///project/source.py" :range range)))
                   (candidate (my--project-symbols-candidate workspace symbol))
                   (affix (my--project-symbols-annotate-builder (list :order mode)))
                   (table (lambda (input predicate action)
                            (if (eq action 'metadata)
                                (list 'metadata (cons 'affixation-function
                                                      (lambda (items) (mapcar affix items))))
                              (complete-with-action action (list candidate) input predicate)))))
              (cl-letf (((symbol-function 'window-body-width) (lambda (&rest _) width)))
                (pcase-let* ((`(,text ,prefix ,suffix) (funcall affix candidate))
                             (rendered (vertico--display-string (concat prefix text suffix)))
                             (widths (my--symbols-column-widths width))
                             (location (string-match "source.py:1" rendered))
                             (parent-column (+ 4 (nth 0 widths) 2))
                             (path-column (+ parent-column (nth 1 widths) 2))
                             (type-column (+ path-column (nth 2 widths) 2)))
                  (should location)
                  (should (= (string-width (substring rendered 0 location))
                             (+ path-column 2)))
                  (should (= (string-width (substring rendered 0 (string-match "P" rendered)))
                             parent-column))
                  (should (= (string-width (substring rendered 0 (string-match "Function" rendered)))
                             type-column))
                  (should (string-search "…" rendered))
                  (should (equal text candidate))
                  (should-not (text-property-not-all 0 (length candidate) 'display nil candidate))
                  (should (eq (consult--lookup-candidate (substring-no-properties text) (list candidate)) symbol))
                  (when (string-search "hidden_name_tail" name)
                    (should-not (string-search "hidden_name_tail" rendered))
                    (should (completion-all-completions "hidden_name_tail" table nil 16)))
                  (should-not (string-search "hidden_parent_tail" rendered))
                  (should (completion-all-completions "&hidden_parent_tail" table nil 19)))))))))))

(ert-deftest my-symbols-path-column-uses-project-root-instead-of-lsp-root ()
  (require 'vertico)
  (let* ((workspace (make-lsp--workspace :root "/projects"))
         (symbol (my--project-symbols-object
                  :name "Example" :kind 5
                  :location (my--project-symbols-object
                             :uri "file:///projects/my-project/src/module.py"
                             :range (my--project-symbols-object
                                     :start (my--project-symbols-object :line 320 :character 0)
                                     :end (my--project-symbols-object :line 321 :character 0)))))
         (candidate (my--project-symbols-candidate workspace symbol))
         (interface (my--project-symbols-interface (list candidate) 'project))
         (view (plist-get interface :view)))
    (setf (plist-get view :root) "/projects/my-project/"
          (plist-get view :order) 'source)
    (should (string-search "my-project/" candidate)) ; server root is the parent
    (should (equal (my--symbols-relative-location candidate (plist-get view :root)) "src/module.py:321"))
    (should (equal (funcall (plist-get interface :group) candidate nil) "src/module.py"))
    (should (equal (my--symbols-relative-location candidate nil) "my-project/src/module.py:321"))
    (pcase-let* ((`(,text ,prefix ,suffix) (funcall (my--project-symbols-annotate-builder view) candidate))
                 (display (vertico--display-string (concat prefix text suffix))))
      (should-not (string-search "my-project/" display))
      (should (string-search "module.py:321" display))
      (should (string-search "Class" display))
      (should (string-search "—" display))
      (should (eq (consult--lookup-candidate (substring-no-properties text) (list candidate)) symbol)))
    (let ((tail (my--symbols-path-tail "deep/very_long_directory/module.py:321" 16)))
      (should (string-prefix-p "…" tail))
      (should (string-suffix-p "module.py:321" tail))
      (should (= (string-width tail) 16)))))

(ert-deftest my-symbols-defaults-and-session-choices-are-independent ()
  (let ((my-buffer-symbols-default-order 'source)
        (my-project-symbols-default-order 'kind)
        (my-symbols-remember-order t)
        (my--symbols-last-orders nil))
    (should (eq (my--symbols-initial-order 'buffer) 'source))
    (should (eq (my--symbols-initial-order 'project) 'kind))
    (setf (alist-get 'buffer my--symbols-last-orders) 'kind)
    (should (eq (my--symbols-initial-order 'buffer) 'kind))
    (should (eq (my--symbols-initial-order 'project) 'kind))
    (let ((my-symbols-remember-order nil))
      (should (eq (my--symbols-initial-order 'buffer) 'source)))
    (should (eq (lookup-key (my--project-symbols-keymap) (kbd "C-c C-s"))
                'my--symbols-toggle-order))))

(ert-deftest my-symbols-source-navigation-skips-children-and-keeps-filtered-roots ()
  (require 'vertico)
  (let* ((my-symbols-remember-order nil)
         (my-project-symbols-default-order 'source)
         (candidates (my--test-symbols-presentation-candidates))
         (my--symbols-view (plist-get (my--project-symbols-interface candidates 'project) :view))
         (vertico--candidates (my--symbols-sort my--symbols-view candidates))
         (vertico--total (length vertico--candidates))
         (vertico--index 0)
         (vertico--allow-prompt nil)
         (vertico--lock-candidate nil))
    ;; Retain real Vertico movement; only completion refresh needs a minibuffer.
    (cl-letf (((symbol-function 'vertico--update) #'ignore))
      (my--symbols-next-group)
      (should (= vertico--index 3))
      (my--symbols-next-group)
      (should (= vertico--index 4)) ; next file's root
      (my--symbols-next-group)
      (should (= vertico--index 0)) ; wrap
      (setq vertico--index 2) ; child of Container
      (my--symbols-previous-group)
      (should (= vertico--index 4)) ; previous root, not the current parent
      (setq vertico--index 3)
      (my--symbols-previous-group)
      (should (= vertico--index 0))
      ;; Hide the parent and another root: children retain the original tree.
      (setq vertico--candidates (list (nth 1 vertico--candidates)
                                      (nth 2 vertico--candidates)
                                      (nth 4 vertico--candidates))
            vertico--total 3 vertico--index 0)
      (my--symbols-next-group)
      (should (= vertico--index 2))
      (my--symbols-previous-group)
      (should (= vertico--index 0))
      (setq vertico--candidates nil vertico--total 0 vertico--index -1)
      (my--symbols-next-group)
      (should (= vertico--index -1)))))

(ert-deftest my-symbols-enclosing-uses-full-ranges-file-and-innermost-scope ()
  (let* ((uri "file:///project/source.py")
         (response (json-parse-string
                    "[{\"name\":\"Example\",\"kind\":5,\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":10,\"character\":0}},\"selectionRange\":{\"start\":{\"line\":0,\"character\":6},\"end\":{\"line\":0,\"character\":13}},\"children\":[{\"name\":\"method\",\"kind\":6,\"range\":{\"start\":{\"line\":2,\"character\":4},\"end\":{\"line\":6,\"character\":12}},\"selectionRange\":{\"start\":{\"line\":2,\"character\":8},\"end\":{\"line\":2,\"character\":14}}}]}]"
                    :object-type (if lsp-use-plists 'plist 'hash-table)))
         (candidates (mapcar (apply-partially #'my--project-symbols-candidate
                                            (make-lsp--workspace :root "/project"))
                             (my--project-symbols-normalize response uri))))
    (cl-flet ((enclosing (line character &optional file)
                (when-let ((candidate
                            (my--symbols-enclosing
                             candidates (or file uri)
                             (my--project-symbols-object :line line :character character))))
                  (lsp-get (get-text-property 0 'consult--candidate candidate) :name))))
      (should (equal (enclosing 4 15) "method")) ; body, not its name
      (should (equal (enclosing 2 4) "method")) ; inclusive start
      (should (equal (enclosing 6 11) "method"))
      (should (equal (enclosing 6 12) "Example")) ; exclusive end
      (should (equal (enclosing 1 0) "Example"))
      (should-not (enclosing 10 0))
      (should-not (enclosing 4 15 "file:///project/other.py")))))

(ert-deftest my-symbols-viewports-center-source-pin-kind-and-scroll-naturally ()
  (require 'vertico)
  (dolist (order '(source kind))
    (dolist (selection '(0 12 28 29))
      (with-temp-buffer
        (let* ((my--symbols-view (list :order order))
               (vertico-count 10)
               (vertico--candidates (mapcar (lambda (i) (format "symbol%02d" i)) (number-sequence 0 29)))
               (vertico--index selection) (vertico--hilit #'identity)
               (my--symbols-placement (if (eq order 'kind) 'top 'center))
               (vertico--metadata nil) (vertico--base "")
               (vertico--allow-prompt nil) (vertico--lock-candidate nil))
          (cl-letf (((symbol-function 'vertico--affixate)
                     (lambda (candidates) (mapcar (lambda (c) (list c "" "")) candidates)))
                    ((symbol-function 'vertico--metadata-get)
                     (lambda (_) (when (eq order 'kind) (lambda (candidate transform) (if transform candidate "Function (30)"))))))
            ;; Rendering is the actual Vertico display path, including headings.
            (let ((lines (my--symbols-arrange-body)))
              (should (<= (length lines) 10))
              (should (string-search (format "symbol%02d" selection) (apply #'concat lines)))
              (if (eq order 'kind)
                  (progn
                    (should (string-search "Function (30)" (car lines)))
                    (should (string-prefix-p (format "symbol%02d" selection) (nth 1 lines)))
                    (should (= vertico--scroll selection)))
                (should (= (length lines) 10))
                (should (= vertico--scroll (min 20 (max 0 (- selection 4)))))))
            (let ((offset vertico--scroll))
              (my--symbols-arrange-body)
              (should (= offset vertico--scroll))
              (when (> offset 0)
                (setq vertico--index (1- offset))
                (let ((lines (my--symbols-arrange-body)))
                  (should (= vertico--scroll (1- offset)))
                  (when (eq order 'kind) (should (string-search "Function (30)" (car lines)))))))
            ;; TAB requests a root/group at the top, even in Source.
            (setq vertico--index 12)
            (my--symbols-place-selection t)
            (my--symbols-arrange-body)
            (should (= vertico--scroll 12))))))))

(ert-deftest my-symbols-sticky-headings-change-at-boundaries-within-row-budget ()
  (with-temp-buffer
    (let* ((my--symbols-view '(:order kind)) (vertico-count 6)
           (vertico--candidates '("a0" "a1" "a2" "b0" "b1" "b2" "c0" "c1"))
           (original (copy-sequence vertico--candidates))
           (vertico--index 2) (vertico--hilit #'identity)
           (my--symbols-placement 'top))
      (cl-letf (((symbol-function 'vertico--affixate)
                 (lambda (cs) (mapcar (lambda (c) (list c "" "")) cs)))
                ((symbol-function 'vertico--metadata-get)
                 (lambda (_) (lambda (candidate transform)
                               (if transform candidate (substring candidate 0 1))))))
        (let ((lines (my--symbols-arrange-body)))
          (should (= (length lines) 6))
          (should (string-search " a " (car lines)))
          (should (string-prefix-p "a2" (nth 1 lines)))
          (should (string-search " b " (nth 2 lines))))
        (setq vertico--index 5)
        (let ((lines (my--symbols-arrange-body)))
          (should (<= (length lines) 6))
          (should (string-search "b2" (apply #'concat lines)))
          (should (string-search
                   (concat " " (substring (nth vertico--scroll vertico--candidates) 0 1) " ")
                   (car lines))))
        (should (= vertico--index 5))
        (should (equal original vertico--candidates))))))

(ert-deftest my-symbols-filter-preserves-surviving-selection-and-resets-missing-selection ()
  (dolist (order '(source kind))
    (dolist (survives '(t nil))
      (with-temp-buffer
        (let* ((my--symbols-view (list :order order))
               (my--symbols-filter-signature '("" nil))
               (consult--narrow nil) (vertico--index 1) (input "query")
               (vertico--candidates '("first" "selected" "last")))
          (cl-letf (((symbol-function 'minibuffer-contents-no-properties) (lambda () input)))
            (my--symbols-update-filter
             (lambda () (setq vertico--candidates (if survives '("other" "selected" "last") '("last"))
                              vertico--index 0)))
            (should (= vertico--index (if survives 1 0)))
            (should (equal (my--symbols-selected) (if survives "selected" "last")))
            (should (eq my--symbols-placement (if (and survives (eq order 'source)) 'center 'top)))
            (setq input "")
            (my--symbols-update-filter
             (lambda () (setq vertico--candidates '("first" "selected" "last") vertico--index 0)))
            (should (equal (my--symbols-selected) (if survives "selected" "last")))))))))

(ert-deftest my-symbols-first-source-switch-focuses-origin-unless-user-has-navigated ()
  (require 'vertico)
  (dolist (scenario '(untouched navigated filtered))
    (with-temp-buffer
      (let* ((my-symbols-remember-order nil)
             (my-buffer-symbols-default-order 'kind)
             (candidates (my--test-symbols-presentation-candidates))
             (my--symbols-view (plist-get (my--project-symbols-interface candidates 'buffer) :view))
             (origin (seq-find (lambda (c) (equal (lsp-get (get-text-property 0 'consult--candidate c) :name)
                                                "first_method")) candidates))
             (vertico--candidates (my--symbols-sort my--symbols-view candidates))
             (vertico--total (length candidates)) (vertico--index 0)
             (vertico--allow-prompt nil) (vertico--lock-candidate nil)
             (vertico--input nil) (vertico--lock-groups nil)
             (consult--narrow nil) (input ""))
        (setf (plist-get my--symbols-view :origin-candidate) origin
              (plist-get my--symbols-view :opening-selection) (car vertico--candidates))
        (cl-letf (((symbol-function 'minibuffer-contents-no-properties) (lambda () input))
                  ((symbol-function 'vertico--exhibit) #'ignore)
                  ((symbol-function 'vertico--update)
                   (lambda (&rest _) (setq vertico--candidates (my--symbols-sort my--symbols-view candidates)))))
          (pcase scenario
            ('navigated
             (setq vertico--index 1)
             (my--symbols-track-selection my--symbols-view)
             (setq vertico--index 0))
            ('filtered
             (setq input "x")
             (my--symbols-track-selection my--symbols-view)
             (setq input "")))
          (my--symbols-toggle-order)
          (should (equal (lsp-get (get-text-property 0 'consult--candidate
                                                    (nth vertico--index vertico--candidates)) :name)
                         (if (eq scenario 'untouched) "first_method" "Container")))
          (should (plist-get my--symbols-view :source-opened)))))))

(ert-deftest my-symbols-preview-uses-window-height-and-accepted-jump-keeps-row ()
  (let* ((file (make-temp-file "symbol-scroll-" nil ".txt"))
         (buffer nil)
         (hook-calls 0)
         (hook (list (lambda () (cl-incf hook-calls))))
         (consult-after-jump-hook hook))
    (unwind-protect
        (save-window-excursion
          (with-temp-file file
            (dotimes (i 300) (insert (format "Line %03d\n" i))))
          (setq buffer (find-file-noselect file))
          (switch-to-buffer buffer)
          (let* ((range (my--project-symbols-object
                         :start (my--project-symbols-object :line 140 :character 0)
                         :end (my--project-symbols-object :line 141 :character 0)))
                 (symbol (my--project-symbols-object
                          :name "target" :kind 12
                          :location (my--project-symbols-object
                                     :uri (lsp--path-to-uri file) :range range)))
                 (state (my--symbols-state)))
            (funcall state 'setup nil)
            (dolist (fraction '(0.25 0.75))
              (let ((my-symbols-window-position fraction))
                (funcall state 'preview symbol)
                (should (= (line-number-at-pos) 141))
                (should (= (current-column) 0))
                (should (= (count-screen-lines (window-start) (line-beginning-position))
                           (floor (* fraction (window-body-height)))))))
            (funcall state 'preview nil)
            (funcall state 'exit nil)
            (let ((my-symbols-window-position 0.25))
              (funcall state 'return symbol)
              (should (= (line-number-at-pos) 141))
              (should (= (current-column) 0))
              (should (= (count-screen-lines (window-start) (line-beginning-position))
                         (floor (* 0.75 (window-body-height)))))))
          (should (= hook-calls 3))
          (should (eq consult-after-jump-hook hook)))
      (when (buffer-live-p buffer) (kill-buffer buffer))
      (delete-file file))))

(ert-deftest my-symbols-locations-use-zero-based-negotiated-columns ()
  (with-temp-buffer
    (insert "top\nA😀βtarget\n")
    (goto-char 2)
    (let ((origin (point)))
      (dolist (encoding '(("utf-8" . 7) ("utf-16" . 4) ("utf-32" . 3)))
        (let* ((position (my--project-symbols-object :line 1 :character (cdr encoding)))
               (marker (my--symbols-location-marker (current-buffer) position (car encoding))))
          (should (= (marker-position marker) 8))
          (should (eq (char-after marker) ?t))
          (should (= (point) origin))
          (set-marker marker nil))))))

(ert-deftest my-symbols-preview-suppresses-flash-but-keeps-other-jump-hooks ()
  (dolist (command '(my/buffer-symbols my/project-symbols))
    (let* ((this-command command)
           (+nav-flash-exclude-commands '(unrelated-command))
           (original-exclusions +nav-flash-exclude-commands)
           (calls 0)
           (consult-after-jump-hook
            (list (lambda ()
                    (should (memq this-command +nav-flash-exclude-commands))
                    (cl-incf calls)))))
      (save-window-excursion
        (with-temp-buffer
          (switch-to-buffer (current-buffer))
          (insert "target\n")
          (let* ((range (my--project-symbols-object
                         :start (my--project-symbols-object :line 0 :character 0)))
                 (candidate (my--project-symbols-object
                             :location (my--project-symbols-object :uri "file:///fixture" :range range)))
                 (state (my--symbols-state)))
            (cl-letf (((symbol-function 'consult--temporary-files)
                       (lambda () (lambda (&rest _) (current-buffer)))))
              ;; Build after installing the isolated temporary-file provider.
              (setq state (my--symbols-state))
              (funcall state 'setup nil)
              (funcall state 'preview candidate)
              (funcall state 'exit candidate)
              (funcall state 'return candidate)))))
      (should (= calls 2))
      (should (eq +nav-flash-exclude-commands original-exclusions)))))

(ert-deftest my-symbols-scope-respects-position-encoding-and-does-not-move-source ()
  (save-window-excursion
    (with-temp-buffer
      (insert "A😀βZ\nnext\nend\n")
      (set-buffer-modified-p nil)
      (switch-to-buffer (current-buffer))
      (goto-char 4)
      (let ((origin (point)) (start (window-start)))
        (dolist (encoding '(("utf-8" 5 7) ("utf-16" 3 4) ("utf-32" 2 3)))
          (let* ((range (my--project-symbols-object
                         :start (my--project-symbols-object :line 0 :character (nth 1 encoding))
                         :end (my--project-symbols-object :line 0 :character (nth 2 encoding))))
                 (symbol (my--project-symbols-object :name "β" :my-scope-range range))
                 (encodings (make-hash-table :test #'eq))
                 (view (list :scope-highlight t :scope-overlay nil :scope-candidate symbol
                             :scope-window (selected-window) :scope-buffer (current-buffer)
                             :scope-encodings encodings))
                 (my--symbols-view view))
            (puthash symbol (car encoding) encodings)
            (unwind-protect
                (progn
                  (my--symbols-refresh-scope view)
                  (let ((overlay (plist-get view :scope-overlay)))
                    (should (= (overlay-start overlay) 3))
                    (should (= (overlay-end overlay) 4))
                    (should (eq (plist-get (overlay-get overlay 'face) :inherit) 'my-symbols-scope-face))
                    (should (eq (overlay-get overlay 'window) (selected-window)))
                    (should (< (overlay-get overlay 'priority) 1))
                    (my--symbols-toggle-scope)
                    (should-not (overlay-buffer overlay))
                    (should-not (plist-get view :scope-overlay)))
                  (my--symbols-toggle-scope)
                  (should (overlayp (plist-get view :scope-overlay)))
                  (let ((vertico--candidates nil) (vertico--index -1))
                    (my--symbols-sync-scope view)
