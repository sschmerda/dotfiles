(ert-deftest my-symbols-scope-follows-preview-and-clears-without-guessing-ranges ()
  (let* ((file (make-temp-file "symbol-scope-" nil ".txt")) buffer)
    (unwind-protect
        (save-window-excursion
          (with-temp-file file (dotimes (i 200) (insert (format "Line %03d\n" i))))
          (setq buffer (find-file-noselect file)) (switch-to-buffer buffer)
          (let* ((range (lambda (line end)
                          (my--project-symbols-object
                           :start (my--project-symbols-object :line line :character 0)
                           :end (my--project-symbols-object :line end :character 0))))
                 (uri (lsp--path-to-uri buffer-file-name))
                 (symbols (my--project-symbols-normalize
                           (list (my--project-symbols-object :name "first" :kind 12
                                  :range (funcall range 40 60) :selectionRange (funcall range 40 41))
                                 (my--project-symbols-object :name "second" :kind 12
                                  :range (funcall range 80 90) :selectionRange (funcall range 80 81))
                                 (my--project-symbols-object :name "name_only" :kind 12
                                  :location (my--project-symbols-object :uri uri :range (funcall range 100 101))))
                           uri))
                 (view (list :scope-highlight t :scope-overlay nil :scope-candidate nil
                             :scope-window nil :scope-buffer nil))
                 (state (my--symbols-state view)))
            (let ((cursor-line (make-overlay (point-min) (1+ (point-min)))))
              (overlay-put cursor-line 'face 'hl-line)
              (funcall state 'setup nil)
              (funcall state 'preview (nth 0 symbols))
              (should-not (overlay-get cursor-line 'face))
              (let ((overlay (plist-get view :scope-overlay)))
                (should (equal (buffer-substring-no-properties (overlay-start overlay) (overlay-end overlay))
                               (mapconcat (lambda (i) (format "Line %03d\n" i)) (number-sequence 40 59) "")))
                (funcall state 'preview (nth 1 symbols))
                (should-not (overlay-buffer overlay)))
              (should (overlayp (plist-get view :scope-overlay)))
              (funcall state 'preview (nth 2 symbols))
              (should-not (plist-get view :scope-overlay))
              (funcall state 'preview (nth 0 symbols))
              (funcall state 'preview nil)
              (should-not (plist-get view :scope-overlay))
              (funcall state 'exit nil)
              (should (eq (overlay-get cursor-line 'face) 'hl-line))
              (funcall state 'return (nth 0 symbols))
              (should-not (plist-get view :scope-overlay))
              (should-not (buffer-modified-p)))))
      (when (buffer-live-p buffer) (kill-buffer buffer))
      (delete-file file))))

