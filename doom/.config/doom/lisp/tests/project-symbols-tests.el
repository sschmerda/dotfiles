         (completion-category-defaults nil)
         (completion-category-overrides nil)
         (orderless-style-dispatchers '(orderless-affix-dispatch))
         (candidates
          (mapcar (lambda (entry)
                    (propertize (car entry)
                                'consult--candidate (my--project-symbols-object :kind (cadr entry))
                                'consult--type (caddr entry)))
                  '(("alpha_function" 12 ?F) ("beta_function" 12 ?F)
                    ("alpha_method" 6 ?M) ("Widget" 23 ?s))))
         (interface (my--project-symbols-interface candidates))
         (view (plist-get interface :view))
         (map (plist-get interface :keymap))
         (group (plist-get interface :group))
         (table (lambda (string predicate action)
                  (if (eq action 'metadata)
                      (list 'metadata
                            (cons 'affixation-function
                                  (lambda (items)
                                    (mapcar (lambda (c)
                                              (list c "" (alist-get
                                                          (get-text-property 0 'consult--type c)
                                                          consult-lsp-symbols-narrow)))
                                            items))))
                    (complete-with-action action candidates string predicate)))))
    (cl-flet ((label (key) (cadr (assq key (cdr (lookup-key map (kbd "<")))))))
             (should (equal (funcall group (car candidates) nil) "Function (2)"))
             (should (equal (label ?a) "Functions + Methods (3)"))
             (should (equal (label ?<) "All (4)"))
             (should (assq ?c (plist-get (plist-get interface :narrow) :keys)))
             (should (equal (label ?c) "Class (0)"))
             (with-temp-buffer
               (setq-local minibuffer-completion-table table)
               ;; Simulate minibuffer text in an isolated test process; retain the real
               ;; completion styles and metadata rather than mocking the matching.
               (cl-letf (((symbol-function 'minibufferp) (lambda (&optional _) t))
                         ((symbol-function 'minibuffer-prompt-end) #'point-min)
                         ((symbol-function 'minibuffer-contents-no-properties)
                          (lambda () (buffer-substring-no-properties (point-min) (point-max)))))
                        (insert "alpha")
                        (let ((consult--narrow ?F))
                          (setq-local minibuffer-completion-predicate
                                      (plist-get (plist-get interface :narrow) :predicate))
                          (my--project-symbols-refresh-counts view)
                          (should (equal (funcall group (car candidates) nil) "Function (1/2)"))
                   (should (equal (label ?M) "Method (1/1)"))
                   (should (equal (label ?c) "Class (0/0)"))
                          (should (equal (label ?s) "Struct (0/1)"))
                          (should (equal (label ?a) "Functions + Methods (2/3)"))
                          (should (equal (label ?<) "All (2/4)")))
                        (erase-buffer)
                        (insert "&Method")
                        (my--project-symbols-refresh-counts view)
                        (should (equal (label ?F) "Function (0/2)"))
                        (should (equal (label ?M) "Method (1/1)"))
                        (erase-buffer)
                        (insert "no-matching-symbol")
                        (my--project-symbols-refresh-counts view)
                        (should (equal (label ?<) "All (0/4)"))
                        (erase-buffer)
                        (my--project-symbols-refresh-counts view)
                        (should (equal (label ?F) "Function (2)")))))))

