;;; signature-tests.el --- Automatic signature behavior -*- lexical-binding: t; -*-
;; Run from DOOMDIR: emacs -Q --batch -l lisp/tests/signature-tests.el
;;   -f ert-run-tests-batch-and-exit
(require 'ert)
(require 'cl-lib)
(let ((build (expand-file-name
              (format "~/.emacs.d/.local/straight/build-%d.%d"
                      emacs-major-version emacs-minor-version))))
  (dolist (directory (directory-files build t "^[^.]"))
    (when (file-directory-p directory) (add-to-list 'load-path directory))))
(load (expand-file-name "../signature-config.el"
                        (file-name-directory (or load-file-name buffer-file-name))) nil t)

(ert-deftest my-documentation-signature-dims-only-inactive-label-text ()
  (require 'lsp-mode)
  (let* ((label (concat "f(" (propertize "active" 'face 'lsp-signature-highlight-function-argument)
                        ", inactive)"))
         (lsp--signature-last-index 0)
         (lsp--signature-last (list :signatures (vector (list :label label))))
         (message (concat label "\nDescription stays normal."))
         (formatted (my--documentation-bottom-signature-content message 80)))
    (should (eq (get-text-property (string-match "active" formatted) 'face formatted)
                'lsp-signature-highlight-function-argument))
    (should (equal (get-text-property (string-match "inactive" formatted) 'face formatted)
                   'my-documentation-signature-inactive))
    (should-not (get-text-property (string-match "Description" formatted) 'face formatted))
    (should-not (get-text-property (string-match "inactive" message) 'face message))))

(ert-deftest my-documentation-signature-scrolls-to-active-parameter-without-focus ()
  (require 'lsp-mode)
  (require 'lv)
  (save-window-excursion
    (let ((lv-wnd nil) (vertico-count 5) (origin (selected-window)))
      (unwind-protect
          (let* ((prefix (mapconcat (lambda (i) (format "parameter_%d" i)) (number-sequence 1 35) "\n"))
                 (message (concat prefix "\n" (propertize "active_parameter" 'face
                                                          '(lsp-signature-highlight-function-argument bold))
                                  "\nlast_parameter"))
                 (active (+ (length prefix) 2)))
            (my--documentation-display-bottom-signature message)
            (should (eq (selected-window) origin))
            (should (= (window-point lv-wnd) active))
            (should (> (window-start lv-wnd) 1)))
        (my--documentation-display-bottom-signature nil)))))

(ert-deftest my-documentation-signature-auto-activation-is-insert-only-and-debounced ()
  (require 'lsp-mode)
  (require 'evil)
  (save-window-excursion
    (with-temp-buffer
      (switch-to-buffer (current-buffer))
      (insert "function(existing_arguments)")
      (setq-local lsp-mode t evil-local-mode t evil-state 'normal lsp-signature-mode nil)
      (let ((scheduled 0) (requested 0) callback)
        (cl-letf (((symbol-function 'run-with-idle-timer)
                   (lambda (_delay _repeat function &rest _) (cl-incf scheduled) (setq callback function) nil))
                  ((symbol-function 'lsp-feature?) (lambda (&rest _) t))
                  ((symbol-function 'lsp-signature-activate)
                   (lambda () (setq-local lsp-signature-mode t)))
                  ((symbol-function 'lsp-signature) (lambda () (cl-incf requested))))
          (my--documentation-signature-auto-h)
          (should (= scheduled 0))
          (setq evil-state 'insert)
          (my--documentation-signature-enter-h)
          (my--documentation-signature-auto-h)
          (should (= scheduled 1))
          (funcall callback)
          (should (= requested 1))
          ;; An active session already has lsp-mode's own update hook.
          (backward-char)
          (my--documentation-signature-auto-h)
          (should (= scheduled 1))
          (setq-local lsp-signature-mode nil)
          (backward-char)
          (my--documentation-signature-auto-h)
          (setq evil-state 'normal)
          (funcall callback)
          (should (= requested 1)))))))

(ert-deftest my-documentation-parameter-lines-preserve-server-characters-and-faces ()
  (require 'lsp-mode)
  (let* ((label "f(a: dict[str, int] = {'x': 1}, *, b: str = 'a,b')")
         (start (string-match "b: str" label))
         (signature (list :label label :parameters
                          (vector (list :label (vector 2 28))
                                  (list :label (vector start (1- (length label)))))))
         (message (concat " 1/2 " (propertize label 'face 'lsp-signature-highlight-function-argument)))
         (formatted (my--documentation-signature-parameter-lines message signature)))
    (should (equal (substring-no-properties formatted)
                   " 1/2 f(\n    a: dict[str, int] = {'x': 1}, *, \n    b: str = 'a,b')"))
    (should (equal-including-properties
             (replace-regexp-in-string "\n    " "" formatted) message))))

(ert-deftest my-documentation-parameter-lines-fall-back-on-ambiguous-metadata ()
  (require 'lsp-mode)
  (dolist (example '(("f(value: value)" [(:label "value")])
                     ("f(a, b)" [(:label [2 3]) (:label [2 3])])
                     ("f(a)" [(:label [999 1000])])
                     ("f(a)" [])))
    (let* ((label (car example))
           (signature (list :label label :parameters (cadr example))))
      (should (eq (my--documentation-signature-parameter-lines label signature) label)))))

(ert-deftest my-documentation-parameter-lines-handle-unicode-and-existing-newlines ()
  (require 'lsp-mode)
  (let ((label "😀f(a, b)"))
    (should (equal (my--documentation-signature-parameter-lines
                    label (list :label label :parameters [(:label [4 5]) (:label [7 8])]))
                   "😀f(\n    a, \n    b)")))
  (let ((label "f(\n    a,\n    b)"))
    (should (eq (my--documentation-signature-parameter-lines
                 label (list :label label :parameters [(:label "a") (:label "b")])) label))))

(ert-deftest my-documentation-signature-preserves-server-text-and-highlight ()
  (require 'lsp-mode)
  (dolist (text '("(low: int, size: None = None, *, dtype: type[bool]) -> bool"
                  "fn compute(values: &[i32], limit: usize) -> Option<i32>"
                  "int f(std::vector<int> values, int flags = 0)"
                  "func Compare(a []int, b []int) bool"
                  "(function ARG1 ARG2)"))
    (let* ((label (propertize text 'face 'lsp-signature-highlight-function-argument))
           (lsp--signature-last-index 0)
           (lsp--signature-last (list :signatures (vector (list :label label))))
           (prefix (concat " 1/25 " label))
           (description "  Indented server description.\n\nExample: f(1, 2)")
           (formatted (my--documentation-bottom-signature-content
                       (concat prefix "\n\f\n" description) 80)))
      (should (equal-including-properties (substring formatted 0 (length prefix)) prefix))
      (should (string-suffix-p description formatted))
      (should (string-match-p (make-string 79 ?─) formatted))
      (should (eq (my--documentation-bottom-signature-content prefix 80) prefix)))))

(ert-deftest my-documentation-signature-unknown-boundary-keeps-original-message ()
  (require 'lsp-mode)
  (let* ((message (propertize "Unusual server format: 😀 x | y" 'face 'bold))
         (lsp--signature-last-index 500)
         (lsp--signature-last (list :signatures (vector (list :label "not in message")))))
    (should (eq (my--documentation-bottom-signature-content message 80) message))
    (setq lsp--signature-last-index 0)
    (should (eq (my--documentation-bottom-signature-content message 80) message))))

(ert-deftest my-documentation-bottom-signature-rejects-recycled-editor-window ()
  (require 'lsp-mode)
  (require 'lv)
  (save-window-excursion
    (with-temp-buffer
      (switch-to-buffer (current-buffer))
      (insert "Source contents must survive")
      (let ((source (current-buffer)) (origin (selected-window))
            (lv-wnd (selected-window)))
        (my--documentation-display-bottom-signature nil)
        (should (window-live-p origin))
        (should (eq (window-buffer origin) source))
        (setq lv-wnd origin)
        (unwind-protect
            (progn
              (my--documentation-display-bottom-signature "function(argument)")
              (should-not (eq lv-wnd origin))
              (should (eq (window-buffer origin) source))
              (should (equal (buffer-string) "Source contents must survive")))
          (my--documentation-display-bottom-signature nil))))))

(ert-deftest my-documentation-bottom-signature-keeps-height-wrap-and-focus ()
  (require 'lsp-mode)
  (require 'lv)
  (save-window-excursion
    (let ((lv-wnd nil) (vertico-count 5)
          (source (current-buffer)) (origin (selected-window)))
      (unwind-protect
          (progn
            (my--documentation-display-bottom-signature
             (propertize "first_argument" 'face 'lsp-signature-highlight-function-argument))
            (let ((height (window-pixel-height lv-wnd)))
              (should (eq (selected-window) origin))
              (should (eq lsp--signature-last-buffer source))
              (with-current-buffer (window-buffer lv-wnd)
                (should visual-line-mode)
                (should-not truncate-lines)
                (should (eq (get-text-property 1 'face)
                            'lsp-signature-highlight-function-argument)))
              (my--documentation-display-bottom-signature
               (concat (make-string 300 ?x) "\nParameter documentation"))
              (should (= height (window-pixel-height lv-wnd)))
              (should (eq (selected-window) origin))))
        (my--documentation-display-bottom-signature nil))
      (should-not (window-live-p lv-wnd)))))


(ert-deftest my-signature-presentation-switches-hide-before-redraw ()
  (require 'lsp-mode)
  (with-temp-buffer
    (let ((my-documentation-signature-style 'bottom)
          (lsp-signature-render-documentation t)
          (lsp--signature-last-buffer (current-buffer))
          (lsp-signature-mode t)
          (lsp--signature-last 'cached)
          calls)
      (cl-letf (((symbol-function 'my--documentation-display-bottom-signature)
                 (lambda (text) (push (list 'bottom text) calls)))
                ((symbol-function 'my--documentation-display-floating-signature)
                 (lambda (text) (push (list 'floating text) calls)))
                ((symbol-function 'message)
                 (lambda (&rest args) (push (list 'compact (cadr args)) calls)))
                ((symbol-function 'lsp--signature->message)
                 (lambda (data)
                   (should (eq data 'cached))
                   (if lsp-signature-render-documentation "Signature + docs" "Signature"))))
        (my/signature-presentation 'floating)
        (should (equal (nreverse calls) '((bottom nil) (floating "Signature"))))
        (should-not lsp-signature-render-documentation)
        (setq calls nil)
        (my/signature-presentation 'compact)
        (should (equal (nreverse calls) '((floating nil) (compact "Signature"))))
        (setq calls nil)
        (my/signature-presentation 'bottom)
        (should (equal (nreverse calls) '((compact nil) (bottom "Signature + docs"))))
        (should lsp-signature-render-documentation)
        (should lsp-signature-mode)))))

(ert-deftest my-signature-presentation-customize-and-inactive-session ()
  (require 'lsp-mode)
  (let ((my-documentation-signature-style 'bottom)
        (lsp-signature-render-documentation t)
        (lsp--signature-last-buffer nil)
        calls)
    (cl-letf (((symbol-function 'my--documentation-display-signature)
               (lambda (text) (push text calls))))
      (let ((setter (get 'my-documentation-signature-style 'custom-set)))
        (should (eq setter 'my--signature-set-presentation))
        (funcall setter 'my-documentation-signature-style 'compact))
      (should (eq my-documentation-signature-style 'compact))
      (should-not lsp-signature-render-documentation)
      (should (equal calls '(nil)))
      (setq calls nil)
      (my/signature-presentation 'compact)
      (should-not calls)
      (should-error (my/signature-presentation 'unknown) :type 'user-error)
      (should (eq my-documentation-signature-style 'compact)))))

(ert-deftest my-signature-presentation-leaves-closed-session-closed ()
  (require 'lsp-mode)
  (with-temp-buffer
    (let ((my-documentation-signature-style 'compact)
          (lsp-signature-render-documentation nil)
          (lsp--signature-last-buffer (current-buffer))
          (lsp-signature-mode nil)
          (lsp--signature-last 'stale))
      (cl-letf (((symbol-function 'my--documentation-display-signature) #'ignore)
                ((symbol-function 'lsp--signature->message)
                 (lambda (_) (ert-fail "Closed signature must not reopen"))))
        (my/signature-presentation 'bottom)
        (should lsp-signature-render-documentation)))))

(ert-deftest my-signature-value-continuations-align-with-value ()
  (let* ((text (propertize "f(\n    data: FirstType | SecondType | ThirdType,\n    count = 100)"
                           'face 'lsp-signature-highlight-function-argument))
         (formatted (my--signature-hanging-values text 80)))
    (should (equal (substring-no-properties formatted) (substring-no-properties text)))
    (should (equal (get-text-property (string-match "FirstType" formatted) 'wrap-prefix formatted)
                   (make-string 10 ?\s)))
    (should (equal (get-text-property (string-match "100" formatted) 'wrap-prefix formatted)
                   (make-string 12 ?\s)))
    (should (eq (get-text-property (string-match "SecondType" formatted) 'face formatted)
                'lsp-signature-highlight-function-argument))
    (should-not (get-text-property (string-match "FirstType" text) 'wrap-prefix text))))

(ert-deftest my-signature-value-indentation-keeps-fallbacks-and-existing-prefixes ()
  (dolist (text '("f(arg: Type)" "    int value" "    value:" "Description stays unchanged"))
    (should (eq (my--signature-hanging-values text 80) text)))
  (let ((text "    very_long_parameter_name: Type"))
    (should (eq (my--signature-hanging-values text 25) text)))
  (let ((text (propertize "    data: Type" 'wrap-prefix "existing")))
    (should (eq (my--signature-hanging-values text 80) text))))

(ert-deftest my-signature-value-indentation-excludes-documentation ()
  (require 'lsp-mode)
  (let* ((label "f(data: FirstType | SecondType)")
         (lsp--signature-last-index 0)
         (lsp--signature-last (list :signatures
                                   (vector (list :label label :parameters
                                                 (vector (list :label "data: FirstType | SecondType"))))))
         (message (concat label "\n    Explanation: This remains ordinary prose."))
         (formatted (my--documentation-bottom-signature-content message 80)))
    (should (equal (get-text-property (string-match "FirstType" formatted) 'wrap-prefix formatted)
                   (make-string 10 ?\s)))
    (should-not (get-text-property (string-match "Explanation" formatted) 'wrap-prefix formatted))))

(ert-deftest my-signature-return-type-emphasis-is-outside-parameters ()
  (require 'lsp-mode)
  (let* ((parameter "callback: Callable[[int], str]")
         (label (concat "f(" parameter ") -> Result[int]"))
         (lsp--signature-last-index 0)
         (lsp--signature-last (list :signatures (vector (list :label label :parameters
                                                             (vector (list :label parameter))))))
         (formatted (my--documentation-bottom-signature-content
                     (concat label "
Documentation -> stays unchanged.") 100)))
    (should (memq 'my-documentation-signature-return
                  (get-text-property (string-match "Result" formatted) 'face formatted)))
    (should-not (memq 'my-documentation-signature-return
                      (ensure-list (get-text-property (string-match "Callable" formatted) 'face formatted))))
    (should-not (get-text-property (string-match "Documentation" formatted) 'face formatted))
    (should (string-suffix-p "Documentation -> stays unchanged." formatted))))

(ert-deftest my-signature-return-boundary-is-conservative ()
  (require 'lsp-mode)
  (let ((label "fn f(callback: fn(i32) -> bool) -> Result"))
    (should (= (my--signature-return-start
                (list :label label :parameters [(:label "callback: fn(i32) -> bool")]))
               (string-match "-> Result" label))))
  (let ((label "f(value: Thing): Result"))
    (should (= (my--signature-return-start
                (list :label label :parameters [(:label "value: Thing")]))
               (string-match ": Result" label))))
  (should-not (my--signature-return-start '(:label "f() -> Result" :parameters [])))
  (dolist (signature '((:label "f(value: Callable[[], int])" :parameters [(:label "value: Callable[[], int]")])
                       (:label "f(x: x) -> x" :parameters [(:label "x")])
                       (:label "f(x) -> Result")
                       (:label "int f(int value)" :parameters [(:label "int value")])
                       (:label "f(x) -> Result" :parameters [(:label [999 1000])])))
    (should-not (my--signature-return-start signature))))

(ert-deftest my-signature-return-clause-has-one-blank-line ()
  (require 'lsp-mode)
  (dolist (marker '("->" ":"))
    (let* ((label (concat "f(value: Input) " marker " Result[Input]"))
           (lsp--signature-last-index 0)
           (lsp--signature-last
            (list :signatures (vector (list :label label :parameters [(:label "value: Input")]))))
           (formatted (my--documentation-bottom-signature-content
                       (concat label "\nReturn documentation.") 80)))
      (should (string-prefix-p (concat "f(\n    value: Input)\n\n" marker " Result[Input]\n")
                               (substring-no-properties formatted)))
      (should (memq 'my-documentation-signature-return
                    (get-text-property (string-match "Result" formatted) 'face formatted)))
      (should-not (get-text-property (string-match "Result" formatted) 'wrap-prefix formatted))
      (should (string-suffix-p "Return documentation." formatted))
      (should (equal label (concat "f(value: Input) " marker " Result[Input]"))))))

(ert-deftest my-signature-separate-return-keeps-existing-spacing-idempotent ()
  (let* ((text (concat "f() \n\n   "
                       (propertize "-> Result" 'face '(my-documentation-signature-return bold))))
         (formatted (my--signature-separate-return text)))
    (should (equal (substring-no-properties formatted) "f()\n\n-> Result"))
    (should (equal-including-properties (my--signature-separate-return formatted) formatted))
    (should (equal (get-text-property (string-match "Result" formatted) 'face formatted)
                   '(my-documentation-signature-return bold))))
  (let ((text "f(callback: fn(int) -> bool) -> Unknown"))
    (should (eq (my--signature-separate-return text) text))))

(ert-deftest my-signature-missing-receiver-boundaries-preserve-server-layout ()
  (require 'lsp-mode)
  (dolist (arguments '("&self" "&mut self" "self" "mut self" "unknown" ""))
    (let* ((label (concat "fn parse<F: FromStr>(" arguments ") -> Result<u32, <u32 as FromStr>::Err>"))
           (signature (list :label label :parameters []))
           (lsp--signature-last-index 0)
           (lsp--signature-last (list :signatures (vector signature)))
           (formatted (my--documentation-bottom-signature-content label 100)))
      (should-not (my--signature-return-start signature))
      (should (equal (substring-no-properties formatted) label))
      (should-not (memq 'my-documentation-signature-return
                        (ensure-list (get-text-property (string-match "Result" formatted) 'face formatted))))))
  ;; When a server DOES supply a boundary for a receiver, it works without
  ;; special handling of its name or Rust syntax.
  (let* ((label "fn parse<F: FromStr>(&self) -> Result<u32, <u32 as FromStr>::Err>")
         (signature (list :label label :parameters [(:label "&self")])))
    (should (= (my--signature-return-start signature) (string-match "->" label)))))

(ert-deftest my-signature-lsp-metadata-includes-signature-and-parameter-docs ()
  (require 'lsp-mode)
  (let* ((lsp--signature-last-index nil)
         (lsp-signature-render-documentation t) (lsp-signature-doc-lines nil)
         (label "f(value: int) -> Result")
         (reply (list :signatures
                      (vector (list :label label :documentation "Function documentation."
                                    :parameters [(:label [2 12] :documentation (:kind "markdown" :value "Parameter **details**."))]))))
         (text (lsp--signature->message reply)))
    (should (string-match-p "Function documentation" text))
    (should (string-match-p "Active parameter" text))
    (should (string-match-p "Parameter" text))
    (should (eq (get-text-property 2 'face text) 'lsp-signature-highlight-function-argument))
    (should-not (get-text-property 2 'face label))
    (should (equal (substring-no-properties (substring text 0 (length label))) label))))

(ert-deftest my-signature-lsp-unicode-offsets-and-active-parameter-precedence ()
  (require 'lsp-mode)
  (let* ((lsp--signature-last-index nil) (lsp-signature-render-documentation nil)
         (label "😀f(a, b)")
         (signature (list :label label :activeParameter 0 :parameters [(:label [4 5]) (:label [7 8])]))
         (reply (list :signatures (vector signature) :activeParameter 1))
         (text (lsp--signature->message reply)))
    (should (eq (get-text-property 3 'face text) 'lsp-signature-highlight-function-argument))
    (should-not (get-text-property 6 'face text))
    ;; Switch parameters without mutating the server's cached label.
    (setq reply (list :signatures (vector (list :label label :parameters
                                               [(:label [4 5]) (:label [7 8])])) :activeParameter 1))
    (setq text (lsp--signature->message reply))
    (should (eq (get-text-property 6 'face text) 'lsp-signature-highlight-function-argument))
    (should-not (get-text-property 3 'face text))
    (should-not (get-text-property 3 'face label))))

(ert-deftest my-signature-lsp-invalid-and-missing-index-fallbacks ()
  (require 'lsp-mode)
  (let* ((lsp--signature-last-index 99) (lsp-signature-render-documentation nil)
         (reply '(:activeSignature 1 :activeParameter 999
                  :signatures [(:label "f(a)" :parameters [(:label [2 3])])
                               (:label "g(b)" :parameters [(:label [2 3])])]))
         (text (lsp--signature->message reply)))
    (should (string-prefix-p " 2/2 g(b)" text))
    (should (= lsp--signature-last-index 1))
    ;; Protocol default: missing/out-of-range active parameter means index zero.
    (should (eq (get-text-property (string-match "b" text) 'face text)
                'lsp-signature-highlight-function-argument))
    (setq lsp--signature-last-index nil)
    (should (string-prefix-p " 1/2 f(a)"
                            (lsp--signature->message '(:activeSignature -1 :signatures
                                                       [(:label "f(a)") (:label "g(b)")]))))
    (should-not (lsp--signature->message '(:signatures [])))))

(ert-deftest my-signature-lsp-unreliable-ranges-keep-label-and-documentation ()
  (require 'lsp-mode)
  (dolist (parameter '((:label [999 1000]) (:label [4 3]) (:label [1 2])
                       (:label "missing") (:label "value")))
    (let* ((lsp--signature-last-index nil) (lsp-signature-render-documentation t)
           (lsp-signature-doc-lines nil)
           (label "😀f(value: value)")
           (reply (list :signatures (vector (list :label label :documentation "Server docs."
                                                  :parameters (vector parameter)))))
           (text (lsp--signature->message reply)))
      (should (equal (substring-no-properties text) (concat label "\nServer docs.")))
      (should-not (text-property-not-all 0 (length label) 'face nil text)))))

(ert-deftest my-signature-lsp-doc-controls-and-plain-text-fallback ()
  (require 'lsp-mode)
  (let* ((lsp--signature-last-index nil) (lsp-signature-render-documentation nil)
         (lsp-signature-doc-lines nil)
         (reply '(:signatures [(:label "f(x)" :documentation "One\nTwo\nThree"
                                      :parameters [(:label [2 3] :documentation "Parameter docs")])]))
         (text (lsp--signature->message reply)))
    (should (equal (substring-no-properties text) "f(x)"))
    (setq lsp-signature-render-documentation t lsp-signature-doc-lines 0)
    (should (equal (substring-no-properties (lsp--signature->message reply)) "f(x)"))
    (setq lsp-signature-doc-lines 2)
    (should (string-suffix-p "Truncated..." (lsp--signature->message reply)))
    (cl-letf (((symbol-function 'lsp--render-element) (lambda (_) (error "Unsupported markup"))))
      (should (equal (my--signature-render-doc '(:kind "markdown" :value "Raw documentation"))
                     "Raw documentation")))))

(ert-deftest my-signature-lsp-native-overload-navigation-still-works ()
  (require 'lsp-mode)
  (let* ((lsp--signature-last-index nil) (lsp-signature-render-documentation nil)
         (lsp-signature-cycle t)
         (reply '(:signatures [(:label "f(a)" :parameters [(:label [2 3])])
                              (:label "f(b)" :parameters [(:label [2 3])])]))
         (text (lsp--signature->message reply))
         (lsp-signature-function (lambda (message) (setq text message))))
    (lsp-signature-next)
    (should (string-prefix-p " 2/2 f(b)" text))
    (lsp-signature-previous)
    (should (string-prefix-p " 1/2 f(a)" text))))
