[core]
    editor = nvim
    pager = delta

[interactive]
    diffFilter = delta --color-only

[init]
    defaultBranch = main

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    dark = true

[merge]
    conflictStyle = zdiff3

[diff]
    colorMoved = default

[pull]
    ff = only

[fetch]
    prune = true

[push]
    autoSetupRemote = true

[include]
    path = ~/.config/git/config.local
